[
  {"id": "pt.grammar.preterito-ar", "type": "grammar", "title": "-ar 動詞過去式", "pattern": "去掉 -ar：eu -ei　você／ele -ou　nós -amos　vocês／eles -aram", "explanation": "完成過去式（pretérito perfeito）講已經結束的動作。以 falar 為例：eu falei、você falou、nós falamos、eles falaram。nós 形與現在式相同，靠上下文判斷。以 -car、-gar、-çar 結尾的動詞，eu 形要改拼法保持發音：toquei、joguei、comecei。", "examples": [{"text": "Eu treinei ontem", "meaning": "我昨天練習了"}, {"text": "Ela cantou muito bem", "meaning": "她唱得很好"}, {"text": "Nós jogamos na roda", "meaning": "我們在圈裡對練了"}, {"text": "Eles chegaram tarde", "meaning": "他們遲到了"}], "pitfalls": ["eu 形沒改拼法：jogei、tocei", "-ou 讀成兩個音節，其實是一個雙母音"], "drills": [{"type": "fill", "text": "Eu ___ ontem（treinar）", "answer": "treinei"}, {"type": "fill", "text": "Ela ___ uma ladainha（cantar）", "answer": "cantou"}, {"type": "fill", "text": "Eles ___ cedo（chegar）", "answer": "chegaram"}, {"type": "fill", "text": "Eu ___ capoeira no sábado（jogar）", "answer": "joguei"}, {"type": "choice", "text": "Eu ___ berimbau ontem", "answer": "toquei", "options": ["toquei", "tocei", "tocou"]}]},
  {"id": "pt.grammar.preterito-er-ir", "type": "grammar", "title": "-er、-ir 動詞過去式", "pattern": "-er：-i　-eu　-emos　-eram；-ir：-i　-iu　-imos　-iram", "explanation": "兩類的 eu 形都是 -i。以 comer 為例：comi、comeu、comemos、comeram。以 abrir 為例：abri、abriu、abrimos、abriram。", "examples": [{"text": "Eu comi feijão", "meaning": "我吃了豆子"}, {"text": "Ele aprendeu rápido", "meaning": "他學得很快"}, {"text": "Nós abrimos a roda", "meaning": "我們開了圈"}, {"text": "Eles partiram ontem", "meaning": "他們昨天出發了"}], "pitfalls": ["套用 -ar 的字尾：eu comei", "ele 形 -eu 與 -iu 搞混"], "drills": [{"type": "fill", "text": "Eu ___ pão de manhã（comer）", "answer": "comi"}, {"type": "fill", "text": "Ele ___ muita água（beber）", "answer": "bebeu"}, {"type": "fill", "text": "O mestre ___ a roda（abrir）", "answer": "abriu"}, {"type": "fill", "text": "Eles ___ a música（aprender）", "answer": "aprenderam"}, {"type": "choice", "text": "Eu ___ tudo", "answer": "entendi", "options": ["entendi", "entendei", "entendeu"]}]},
  {"id": "pt.grammar.preterito-ser-ir", "type": "grammar", "title": "ser 與 ir 的過去式：fui", "pattern": "eu fui　você／ele foi　nós fomos　vocês／eles foram", "explanation": "ser 與 ir 的完成過去式完全相同，靠上下文分辨：Eu fui ao Brasil（我去了巴西）、Foi muito bom（那很棒）。", "examples": [{"text": "Eu fui ao treino", "meaning": "我去練習了"}, {"text": "Ela foi para casa", "meaning": "她回家了"}, {"text": "Foi um jogo bonito", "meaning": "那是一場漂亮的對練"}, {"text": "Nós fomos à praia", "meaning": "我們去了海灘"}], "pitfalls": ["照規則變成 eu ii 或 eu sei", "foi 與 fui 用反"], "drills": [{"type": "fill", "text": "Eu ___ ao treino ontem（我昨天去練習了）", "answer": "fui"}, {"type": "fill", "text": "Ela ___ para a Bahia（她去了巴伊亞）", "answer": "foi"}, {"type": "fill", "text": "Nós ___ à roda（我們去了圈）", "answer": "fomos"}, {"type": "fill", "text": "A aula ___ muito boa（那堂課很棒）", "answer": "foi"}, {"type": "choice", "text": "Eles ___ ao batizado", "answer": "foram", "options": ["foram", "fomos", "foi"]}]},
  {"id": "pt.grammar.preterito-irregular", "type": "grammar", "title": "ter、estar、fazer 的過去式", "pattern": "ter：tive／teve　estar：estive／esteve　fazer：fiz／fez", "explanation": "這三個動詞的過去式字根改變，eu 形與 ele 形只差一個母音：tive／teve、estive／esteve、fiz／fez。複數是 tivemos／tiveram、estivemos／estiveram、fizemos／fizeram。", "examples": [{"text": "Eu tive aula ontem", "meaning": "我昨天有課"}, {"text": "Ela esteve aqui", "meaning": "她來過這裡"}, {"text": "Eu fiz o almoço", "meaning": "我做了午餐"}, {"text": "O que você fez?", "meaning": "你做了什麼？"}], "pitfalls": ["照規則變成 eu fazi、eu estei", "fiz 與 fez 用反"], "drills": [{"type": "fill", "text": "Eu ___ o jantar（我做了晚餐）", "answer": "fiz"}, {"type": "fill", "text": "O que você ___ ontem?（你昨天做了什麼？）", "answer": "fez"}, {"type": "fill", "text": "Eu ___ aula ontem（我昨天有課）", "answer": "tive"}, {"type": "choice", "text": "Ela ___ no Brasil em janeiro", "answer": "esteve", "options": ["esteve", "estive", "estou"]}, {"type": "choice", "text": "fazer 的 eu 過去式是？", "answer": "fiz", "options": ["fiz", "fez", "fazi"]}]},
  {"id": "pt.word.falei", "type": "word", "text": "falei", "ipa": "faˈlej", "pos": "v.", "meaning": "我說了", "note": "falar 的過去式（eu）。", "examples": [{"text": "Eu falei com o mestre ontem", "meaning": "我昨天和師父說過話"}]},
  {"id": "pt.word.falou", "type": "word", "text": "falou", "ipa": "faˈlow", "pos": "v.", "meaning": "他說了、你說了", "note": "falar 的過去式（você／ele／ela）。", "examples": [{"text": "Ele falou muito rápido", "meaning": "他說得很快"}]},
  {"id": "pt.word.comi", "type": "word", "text": "comi", "ipa": "koˈmi", "pos": "v.", "meaning": "我吃了", "note": "comer 的過去式（eu）。", "examples": [{"text": "Eu comi arroz com feijão", "meaning": "我吃了飯配燉豆"}]},
  {"id": "pt.word.fui", "type": "word", "text": "fui", "ipa": "fuj", "pos": "v.", "meaning": "我去了／我曾是", "note": "ir 與 ser 的過去式（eu），兩者同形。", "examples": [{"text": "Eu fui ao treino ontem", "meaning": "我昨天去練習了"}]},
  {"id": "pt.word.foi", "type": "word", "text": "foi", "ipa": "foj", "pos": "v.", "meaning": "他去了／那曾是", "note": "ir 與 ser 的過去式（você／ele／ela）。", "examples": [{"text": "Foi um jogo muito bonito", "meaning": "那是一場很漂亮的對練"}]},
  {"id": "pt.word.fiz", "type": "word", "text": "fiz", "ipa": "fis", "pos": "v.", "meaning": "我做了", "note": "fazer 的過去式（eu）。", "examples": [{"text": "Eu fiz o jantar hoje", "meaning": "我今天做了晚餐"}]},
  {"id": "pt.word.fez", "type": "word", "text": "fez", "ipa": "fes", "pos": "v.", "meaning": "他做了、你做了", "note": "fazer 的過去式（você／ele／ela）。", "examples": [{"text": "O que você fez ontem?", "meaning": "你昨天做了什麼？"}]},
  {"id": "pt.word.tive", "type": "word", "text": "tive", "ipa": "ˈtʃivi", "pos": "v.", "meaning": "我有過", "note": "ter 的過去式（eu）。ele 形是 teve。", "examples": [{"text": "Eu tive aula de manhã", "meaning": "我早上有課"}]}
]
