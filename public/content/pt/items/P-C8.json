[
  {"id": "pt.grammar.imperativo-formal", "type": "grammar", "title": "標準命令式（對 você）", "pattern": "-ar → -e　-er／-ir → -a", "explanation": "標準的命令式把字尾母音「對調」：-ar 動詞用 -e（fale），-er、-ir 動詞用 -a（coma、abra）。這個形式用在說明書、告示與較客氣的場合。不規則的有 vá（去）、venha（來）、faça（做）。否定只要在前面加 não：Não fale。", "examples": [{"text": "Fale mais devagar, por favor", "meaning": "請說慢一點"}, {"text": "Abra a porta", "meaning": "請開門"}, {"text": "Venha cá", "meaning": "請過來"}, {"text": "Não pare", "meaning": "不要停"}], "pitfalls": ["把 -ar 動詞的標準命令式寫成 -a（那是口語形）", "否定時 não 放後面"], "drills": [{"type": "fill", "text": "___ mais devagar（falar，請說慢一點）", "answer": "fale"}, {"type": "fill", "text": "___ a porta（abrir，請開門）", "answer": "abra"}, {"type": "choice", "text": "comer 的標準命令式是？", "answer": "coma", "options": ["coma", "come", "como"]}, {"type": "choice", "text": "ir 的標準命令式是？", "answer": "vá", "options": ["vá", "vai", "vou"]}]},
  {"id": "pt.grammar.imperativo-informal", "type": "grammar", "title": "口語命令式", "pattern": "直接用 você／ele 的現在式：fala、come、abre", "explanation": "巴西口語中，對朋友或學生下指令多半直接用第三人稱單數的現在式：Fala!、Come!、Abre!。不規則動詞也一樣：Vai!（去）、Vem!（來）、Faz!（做）、Olha!（看）。課堂上老師喊的口令幾乎都是這個形式。", "examples": [{"text": "Vem cá", "meaning": "過來"}, {"text": "Olha para mim", "meaning": "看著我"}, {"text": "Espera um pouco", "meaning": "等一下"}, {"text": "Faz de novo", "meaning": "再做一次"}], "pitfalls": ["以為 Vai! 是「他去」，在口令裡是「去！、上！」"], "drills": [{"type": "fill", "text": "___ cá!（vir，過來！）", "answer": "vem"}, {"type": "fill", "text": "___ um pouco（esperar，等一下）", "answer": "espera"}, {"type": "choice", "text": "「再做一次」是？", "answer": "Faz de novo", "options": ["Faz de novo", "Fazer de novo", "Fiz de novo"]}, {"type": "reorder", "text": "看著我", "answer": "olha para mim"}, {"type": "choice", "text": "口語命令式和哪個形式相同？", "answer": "ele 的現在式", "options": ["ele 的現在式", "eu 的現在式", "動詞原形"]}]},
  {"id": "pt.grammar.comandos-roda", "type": "grammar", "title": "圈裡的口令", "pattern": "Vai!　Joga!　Entra na roda!　Solta o jogo!", "explanation": "圈裡的口令都是口語命令式。Vai! 是「上！」，Joga! 是「打！、玩起來！」，Entra na roda 是「進圈」，Sai 是「出來」，Solta o jogo 是「放開來打」。Iê! 不是動詞，是領唱者要大家注意或停下的呼喊。", "examples": [{"text": "Entra na roda", "meaning": "進圈"}, {"text": "Joga bonito", "meaning": "打得漂亮一點"}, {"text": "Solta o jogo", "meaning": "放開來打"}, {"text": "Compra o jogo", "meaning": "買場（切入別人的對練）"}], "pitfalls": ["把 Joga! 理解成「丟」，jogar 在卡波耶拉裡是「對練」"], "drills": [{"type": "fill", "text": "___ na roda!（entrar，進圈！）", "answer": "entra"}, {"type": "fill", "text": "___ bonito!（jogar，打得漂亮！）", "answer": "joga"}, {"type": "choice", "text": "領唱者喊 Iê! 的意思是？", "answer": "注意、停下", "options": ["注意、停下", "進圈", "再快一點"]}, {"type": "reorder", "text": "現在進圈", "answer": "entra na roda agora"}, {"type": "choice", "text": "「放開來打」是？", "answer": "Solta o jogo", "options": ["Solta o jogo", "Compra o jogo", "Para o jogo"]}]},
  {"id": "pt.grammar.comandos-treino", "type": "grammar", "title": "練習課的口令", "pattern": "Desce!　Sobe!　Gira!　Esquiva!　De novo!", "explanation": "練習時老師常喊的動作口令：Desce（蹲低）、Sobe（起來）、Gira（轉）、Esquiva（閃）、Chuta（踢）、Canta（唱）、Bate palmas（拍手）。De novo 是「再一次」，Mais rápido 是「快一點」，Devagar 是「慢慢來」，Respira 是「呼吸」。", "examples": [{"text": "Desce mais na ginga", "meaning": "搖擺步再蹲低一點"}, {"text": "Canta mais alto", "meaning": "唱大聲一點"}, {"text": "Bate palmas", "meaning": "拍手"}, {"text": "De novo, mais rápido", "meaning": "再一次，快一點"}], "pitfalls": ["聽到 Desce 往上站：descer 是下降，subir 才是上升"], "drills": [{"type": "fill", "text": "___ mais na ginga（descer，再蹲低一點）", "answer": "desce"}, {"type": "fill", "text": "___ mais alto!（cantar，唱大聲一點！）", "answer": "canta"}, {"type": "choice", "text": "「再一次」是？", "answer": "De novo", "options": ["De novo", "Devagar", "Mais rápido"]}, {"type": "choice", "text": "Desce! 的意思是？", "answer": "蹲低", "options": ["蹲低", "起來", "轉身"]}, {"type": "reorder", "text": "現在唱大聲一點", "answer": "canta mais alto agora"}]}
]
