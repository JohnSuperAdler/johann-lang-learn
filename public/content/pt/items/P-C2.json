[
  {"id": "pt.grammar.ser", "type": "grammar", "title": "ser 現在式", "pattern": "eu sou　você／ele／ela é　nós somos　vocês／eles／elas são", "explanation": "ser 表示身分、職業、國籍、個性、來源、時間等不太會變的性質。você 與 a gente 都用第三人稱單數 é。主詞常可省略，因為動詞形式已經透露是誰。", "examples": [{"text": "Eu sou de Taiwan", "meaning": "我來自台灣"}, {"text": "Ela é professora", "meaning": "她是老師"}, {"text": "Nós somos amigos", "meaning": "我們是朋友"}, {"text": "Eles são brasileiros", "meaning": "他們是巴西人"}], "pitfalls": ["você 用了 sou：Você sou", "把 é 與連接詞 e（和）搞混，é 有重音符號且是開口音"], "drills": [{"type": "fill", "text": "Eu ___ estudante（我是學生）", "answer": "sou"}, {"type": "fill", "text": "Você ___ brasileiro?（你是巴西人嗎？）", "answer": "é"}, {"type": "fill", "text": "Nós ___ amigos（我們是朋友）", "answer": "somos"}, {"type": "fill", "text": "Eles ___ de Taiwan（他們來自台灣）", "answer": "são"}, {"type": "reorder", "text": "我是台灣人", "answer": "eu sou de Taiwan"}]},
  {"id": "pt.grammar.estar", "type": "grammar", "title": "estar 現在式", "pattern": "eu estou　você／ele／ela está　nós estamos　vocês／eles／elas estão", "explanation": "estar 表示暫時的狀態、心情、所在位置。口語中常縮短成 tô、tá、tamos、tão。estar ＋ 動詞的 -ndo 形式表示正在進行：estou treinando（我正在練習）。", "examples": [{"text": "Eu estou cansado", "meaning": "我累了"}, {"text": "Ela está em casa", "meaning": "她在家"}, {"text": "Nós estamos bem", "meaning": "我們很好"}, {"text": "Eles estão na roda", "meaning": "他們在圈裡"}], "pitfalls": ["漏掉 está 的重音符號，esta 是「這個」", "位置用 ser：Eu sou em casa"], "drills": [{"type": "fill", "text": "Eu ___ com fome（我肚子餓）", "answer": "estou"}, {"type": "fill", "text": "Você ___ bem?（你還好嗎？）", "answer": "está"}, {"type": "fill", "text": "Nós ___ em casa（我們在家）", "answer": "estamos"}, {"type": "fill", "text": "Eles ___ cansados（他們累了）", "answer": "estão"}, {"type": "reorder", "text": "我今天很累", "answer": "eu estou cansado hoje"}]},
  {"id": "pt.grammar.ser-estar", "type": "grammar", "title": "ser 還是 estar？", "pattern": "ser ＝ 是什麼（本質）　estar ＝ 怎麼樣、在哪裡（狀態）", "explanation": "兩個動詞都翻成「是」。ser 講本質與身分，estar 講當下的狀態與位置。同一個形容詞換動詞，意思就不同：Ele é feliz 是「他是個快樂的人」，Ele está feliz 是「他現在很開心」。固定不動的地點（城市、建築）用 ser 或 ficar。", "examples": [{"text": "Ela é bonita", "meaning": "她長得漂亮（本質）"}, {"text": "Ela está bonita hoje", "meaning": "她今天很漂亮（狀態）"}, {"text": "O café está quente", "meaning": "咖啡是熱的（現在）"}], "pitfalls": ["國籍、職業用 estar：Eu estou brasileiro", "心情、疲累用 ser：Eu sou cansado"], "drills": [{"type": "choice", "text": "Eu ___ de Taiwan（來源）", "answer": "sou", "options": ["sou", "estou"]}, {"type": "choice", "text": "Eu ___ cansado hoje（今天的狀態）", "answer": "estou", "options": ["estou", "sou"]}, {"type": "choice", "text": "Ela ___ médica（職業）", "answer": "é", "options": ["é", "está"]}, {"type": "choice", "text": "O café ___ frio（現在的狀態）", "answer": "está", "options": ["está", "é"]}, {"type": "choice", "text": "Nós ___ na praia（所在位置）", "answer": "estamos", "options": ["estamos", "somos"]}]},
  {"id": "pt.grammar.ter", "type": "grammar", "title": "ter 現在式", "pattern": "eu tenho　você／ele／ela tem　nós temos　vocês／eles／elas têm", "explanation": "ter 表示「有」。葡語用 ter 說年齡（ter … anos）。口語中 tem 也表示「存在、有」：Tem uma roda hoje（今天有一場圈）。複數 têm 與單數 tem 發音幾乎相同，只差在符號。", "examples": [{"text": "Eu tenho dois irmãos", "meaning": "我有兩個兄弟"}, {"text": "Ela tem vinte anos", "meaning": "她二十歲"}, {"text": "Tem aula hoje?", "meaning": "今天有課嗎？"}], "pitfalls": ["年齡用 ser：Eu sou vinte anos", "複數忘了寫符號：eles tem"], "drills": [{"type": "fill", "text": "Eu ___ um berimbau（我有一把弓琴）", "answer": "tenho"}, {"type": "fill", "text": "Ela ___ trinta anos（她三十歲）", "answer": "tem"}, {"type": "fill", "text": "Nós ___ aula hoje（我們今天有課）", "answer": "temos"}, {"type": "choice", "text": "Eles ___ dois filhos", "answer": "têm", "options": ["têm", "tem", "temos"]}, {"type": "reorder", "text": "我二十歲", "answer": "eu tenho vinte anos"}]},
  {"id": "pt.grammar.ter-que", "type": "grammar", "title": "ter que ＋ 動詞原形：必須", "pattern": "ter que ＋ 原形", "explanation": "ter 後面接 que 與動詞原形，表示「必須、得要」。也可以說 ter de，意思相同。", "examples": [{"text": "Eu tenho que treinar", "meaning": "我得練習"}, {"text": "Você tem que cantar", "meaning": "你必須唱歌"}, {"text": "Nós temos que ir agora", "meaning": "我們現在得走了"}], "pitfalls": ["漏掉 que：Eu tenho treinar", "後面的動詞做了變化：Eu tenho que treino"], "drills": [{"type": "fill", "text": "Eu ___ que trabalhar amanhã（我明天得上班）", "answer": "tenho"}, {"type": "fill", "text": "Você tem ___ descansar（你必須休息）", "answer": "que"}, {"type": "choice", "text": "Nós temos que ___ mais", "answer": "treinar", "options": ["treinar", "treinamos", "treino"]}, {"type": "reorder", "text": "我今天必須練習", "answer": "eu tenho que treinar hoje"}]}
]
