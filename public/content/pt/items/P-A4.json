[
  {"id": "pt.grammar.acentos", "type": "grammar", "title": "四種重音符號", "pattern": "´ 開口重讀　^ 閉口重讀　~ 鼻音　` 縮合", "explanation": "葡語有四種加在母音上的符號。尖音符 ´（á é í ó ú）表示重讀，且 e、o 是開口音。閉音符 ^（â ê ô）表示重讀，且母音是閉口音。波浪號 ~（ã õ）表示鼻音，通常也是重讀音節。重音符 `（à）不改變發音，只表示介系詞 a 與冠詞 a 縮合在一起。", "examples": [{"text": "café", "meaning": "咖啡（é 開口、重讀）"}, {"text": "você", "meaning": "你（ê 閉口、重讀）"}, {"text": "coração", "meaning": "心（ão 鼻音）"}, {"text": "às vezes", "meaning": "有時候（a＋as 縮合）"}], "pitfalls": ["把 ´ 與 ^ 當成同一種符號，忽略開口與閉口的差別", "漏寫符號：avó（祖母）與 avô（祖父）是不同的字"], "drills": [{"type": "choice", "text": "哪個符號表示鼻音？", "answer": "~", "options": ["~", "´", "^", "`"]}, {"type": "choice", "text": "ê 的發音是？", "answer": "閉口 e", "options": ["閉口 e", "開口 e", "鼻音 e"]}, {"type": "choice", "text": "「祖母」的正確拼法是？", "answer": "avó", "options": ["avó", "avô", "avo"]}, {"type": "fill", "text": "caf___（咖啡）", "answer": "é"}, {"type": "choice", "text": "à 的符號表示什麼？", "answer": "介系詞 a 與冠詞 a 縮合", "options": ["介系詞 a 與冠詞 a 縮合", "鼻音", "開口重讀"]}]},
  {"id": "pt.word.sofa", "type": "word", "text": "sofá", "ipa": "soˈfa", "pos": "n.m.", "meaning": "沙發", "note": "´：重音在最後一個音節，a 開口。", "examples": [{"text": "O gato está no sofá", "meaning": "貓在沙發上"}]},
  {"id": "pt.word.jacare", "type": "word", "text": "jacaré", "ipa": "ʒakaˈɾɛ", "pos": "n.m.", "meaning": "鱷魚（凱門鱷）", "note": "´：é 是開口的 [ɛ]。", "examples": [{"text": "O jacaré mora no rio", "meaning": "鱷魚住在河裡"}]},
  {"id": "pt.word.portugues", "type": "word", "text": "português", "ipa": "poɾtuˈɡes", "pos": "n.m.", "meaning": "葡萄牙語", "note": "^：ê 是閉口的 [e]。語言名稱不大寫。", "examples": [{"text": "Eu estudo português", "meaning": "我學葡萄牙語"}]},
  {"id": "pt.word.robo", "type": "word", "text": "robô", "ipa": "hoˈbo", "pos": "n.m.", "meaning": "機器人", "note": "^：ô 是閉口的 [o]。字首 r 讀 [h]。", "examples": [{"text": "O robô fala português", "meaning": "機器人會說葡語"}]},
  {"id": "pt.word.coracao", "type": "word", "text": "coração", "ipa": "koɾaˈsɐ̃w̃", "pos": "n.m.", "meaning": "心、心臟", "note": "~：ão 是鼻音雙母音，重音也在這裡。", "examples": [{"text": "Você está no meu coração", "meaning": "你在我心裡"}]},
  {"id": "pt.word.la", "type": "word", "text": "lã", "ipa": "lɐ̃", "pos": "n.f.", "meaning": "羊毛", "note": "~：鼻音 a，結尾沒有 n 的音。", "examples": [{"text": "Esta blusa é de lã", "meaning": "這件上衣是羊毛的"}]},
  {"id": "pt.word.as-vezes", "type": "word", "text": "às vezes", "ipa": "az ˈvezis", "pos": "adv.", "meaning": "有時候", "note": "`：à 的發音與 a 相同。", "examples": [{"text": "Às vezes eu treino sozinho", "meaning": "我有時候自己練習"}]},
  {"id": "pt.grammar.paroxitona", "type": "grammar", "title": "規則一：字尾是 a、e、o → 重音在倒數第二音節", "pattern": "-a(s)、-e(s)、-o(s)、-am、-em → 倒數第二音節", "explanation": "大多數葡語單字以 a、e、o（或加 s）結尾，還有動詞字尾 -am、-em。這些字的重音自動落在倒數第二個音節，不需要寫符號。例如 ca-sa、no-me、ga-to、fa-lam。", "examples": [{"text": "casa", "meaning": "家（CA-sa）"}, {"text": "falam", "meaning": "他們說（FA-lam）"}, {"text": "obrigado", "meaning": "謝謝（o-bri-GA-do）"}], "pitfalls": ["把重音放在最後一個音節，像唸法語那樣"], "drills": [{"type": "choice", "text": "casa 的重音在哪個音節？", "answer": "ca", "options": ["ca", "sa"]}, {"type": "choice", "text": "obrigado 的重音在哪個音節？", "answer": "ga", "options": ["ga", "o", "bri", "do"]}, {"type": "choice", "text": "falam 的重音在哪個音節？", "answer": "fa", "options": ["fa", "lam"]}, {"type": "choice", "text": "以 -o 結尾、沒有符號的字，重音在？", "answer": "倒數第二音節", "options": ["倒數第二音節", "最後音節", "第一音節"]}]},
  {"id": "pt.grammar.oxitona", "type": "grammar", "title": "規則二：字尾是 i、u、l、r、z 或鼻音 → 重音在最後音節", "pattern": "-i、-u、-l、-r、-z、-im、-um、-ão、-ã → 最後音節", "explanation": "以 i、u 或子音 l、r、z 結尾的字，還有以 -im、-um、-ão、-ã 結尾的字，重音落在最後一個音節，不需要寫符號。所有動詞原形都以 r 結尾，所以重音都在最後：fa-LAR、co-MER。", "examples": [{"text": "falar", "meaning": "說（fa-LAR）"}, {"text": "Brasil", "meaning": "巴西（Bra-SIL）"}, {"text": "feliz", "meaning": "快樂（fe-LIZ）"}, {"text": "aqui", "meaning": "這裡（a-QUI）"}], "pitfalls": ["把 Brasil 唸成 BRA-sil（受英語影響）", "動詞原形重音放錯：FA-lar"], "drills": [{"type": "choice", "text": "Brasil 的重音在哪個音節？", "answer": "sil", "options": ["sil", "Bra"]}, {"type": "choice", "text": "falar 的重音在哪個音節？", "answer": "lar", "options": ["lar", "fa"]}, {"type": "choice", "text": "aqui 的重音在哪個音節？", "answer": "qui", "options": ["qui", "a"]}, {"type": "choice", "text": "以 -r 結尾、沒有符號的字，重音在？", "answer": "最後音節", "options": ["最後音節", "倒數第二音節", "第一音節"]}]},
  {"id": "pt.grammar.acento-grafico", "type": "grammar", "title": "規則三：有符號就照符號重讀", "pattern": "不符合規則一、二的字 → 一定寫符號", "explanation": "重音位置不符合前兩條規則時，就必須在重讀的母音上寫 ´ 或 ^。因此看到符號，直接重讀那個音節即可。重音在倒數第三音節的字一律有符號：MÚ-si-ca、RÁ-pi-do、SÁ-ba-do。以 a、e、o 結尾但重音在最後的字也要寫：ca-FÉ、so-FÁ、vo-CÊ。", "examples": [{"text": "música", "meaning": "音樂（MÚ-si-ca）"}, {"text": "rápido", "meaning": "快（RÁ-pi-do）"}, {"text": "café", "meaning": "咖啡（ca-FÉ）"}], "pitfalls": ["忽略符號，照規則一唸成 mu-SI-ca", "寫字時漏掉符號"], "drills": [{"type": "choice", "text": "música 的重音在哪個音節？", "answer": "mú", "options": ["mú", "si", "ca"]}, {"type": "choice", "text": "重音在倒數第三音節的字，需要寫符號嗎？", "answer": "一律要寫", "options": ["一律要寫", "不用寫", "只有名詞要寫"]}, {"type": "fill", "text": "r___pido（快）", "answer": "á"}, {"type": "choice", "text": "哪一個字的重音在最後一個音節？", "answer": "café", "options": ["café", "casa", "música"]}]},
  {"id": "pt.word.casa", "type": "word", "text": "casa", "ipa": "ˈkazɐ", "pos": "n.f.", "meaning": "家、房子", "note": "規則一：CA-sa。母音之間的 s 讀 [z]。", "examples": [{"text": "Minha casa é pequena", "meaning": "我的家很小"}]},
  {"id": "pt.word.falam", "type": "word", "text": "falam", "ipa": "ˈfalɐ̃w̃", "pos": "v.", "meaning": "他們說（falar 的現在式）", "note": "規則一：FA-lam。字尾 -am 是弱的鼻音。", "examples": [{"text": "Eles falam português", "meaning": "他們說葡萄牙語"}]},
  {"id": "pt.word.falar", "type": "word", "text": "falar", "ipa": "faˈlaɾ", "pos": "v.", "meaning": "說、講", "note": "規則二：fa-LAR。", "examples": [{"text": "Eu quero falar português", "meaning": "我想說葡萄牙語"}]},
  {"id": "pt.word.brasil", "type": "word", "text": "Brasil", "ipa": "bɾaˈziw", "pos": "n.m.", "meaning": "巴西", "note": "規則二：Bra-SIL。字尾 l 讀 [w]。", "examples": [{"text": "Eu quero conhecer o Brasil", "meaning": "我想去認識巴西"}]},
  {"id": "pt.word.feliz", "type": "word", "text": "feliz", "ipa": "feˈlis", "pos": "adj.", "meaning": "快樂、幸福", "note": "規則二：fe-LIZ。字尾 z 讀 [s]。", "examples": [{"text": "Eu estou muito feliz", "meaning": "我很快樂"}]},
  {"id": "pt.word.aqui", "type": "word", "text": "aqui", "ipa": "aˈki", "pos": "adv.", "meaning": "這裡", "note": "規則二：a-QUI。qui 的 u 不發音。", "examples": [{"text": "Eu moro aqui", "meaning": "我住在這裡"}]},
  {"id": "pt.word.musica", "type": "word", "text": "música", "ipa": "ˈmuzikɐ", "pos": "n.f.", "meaning": "音樂", "note": "規則三：MÚ-si-ca。", "examples": [{"text": "Eu gosto de música brasileira", "meaning": "我喜歡巴西音樂"}]},
  {"id": "pt.word.rapido", "type": "word", "text": "rápido", "ipa": "ˈhapidu", "pos": "adj.", "meaning": "快", "note": "規則三：RÁ-pi-do。字首 r 讀 [h]。", "examples": [{"text": "Ele fala muito rápido", "meaning": "他說得很快"}]}
]
