[
  {"id": "pt.letter.a-agudo", "type": "letter", "text": "á", "roman": "開口 a [a]", "name": "嘴張大的「啊」，´ 同時標出重音", "tts": "sofá", "note": "尖音符 ´ 表示這個音節重讀，而且母音是開口的。", "examples": [{"text": "sofá", "meaning": "沙發"}, {"text": "lá", "meaning": "那裡"}]},
  {"id": "pt.letter.e-agudo", "type": "letter", "text": "é", "roman": "開口 e [ɛ]", "name": "嘴張得比較開，像英語 bed 的 e", "tts": "café", "note": "嘴角往兩邊拉、下巴往下。", "examples": [{"text": "café", "meaning": "咖啡"}, {"text": "pé", "meaning": "腳"}]},
  {"id": "pt.letter.e-circ", "type": "letter", "text": "ê", "roman": "閉口 e [e]", "name": "嘴比較閉，像注音「ㄟ」的前半", "tts": "você", "note": "閉音符 ^ 表示重讀且母音是閉口的。\n不要滑成「ei」。", "examples": [{"text": "você", "meaning": "你"}, {"text": "português", "meaning": "葡萄牙語"}]},
  {"id": "pt.letter.o-agudo", "type": "letter", "text": "ó", "roman": "開口 o [ɔ]", "name": "嘴張得比較開，像英語 law 的母音", "tts": "avó", "note": "下巴往下，嘴唇圓。", "examples": [{"text": "avó", "meaning": "祖母"}, {"text": "nós", "meaning": "我們"}]},
  {"id": "pt.letter.o-circ", "type": "letter", "text": "ô", "roman": "閉口 o [o]", "name": "嘴比較閉、比較圓，像注音「ㄛ」", "tts": "avô", "note": "avó（祖母）與 avô（祖父）只差在這個母音的開閉。", "examples": [{"text": "avô", "meaning": "祖父"}, {"text": "robô", "meaning": "機器人"}]},
  {"id": "pt.letter.e-final", "type": "letter", "text": "-e", "roman": "字尾弱化成 [i]", "name": "非重讀的字尾 e 讀成「衣」", "tts": "nome", "note": "只限非重讀的字尾。有重音符號的 é、ê 不變。", "examples": [{"text": "nome", "meaning": "名字"}, {"text": "leite", "meaning": "牛奶"}]},
  {"id": "pt.letter.o-final", "type": "letter", "text": "-o", "roman": "字尾弱化成 [u]", "name": "非重讀的字尾 o 讀成「烏」", "tts": "gato", "note": "只限非重讀的字尾。obrigado 的最後一個音是「烏」。", "examples": [{"text": "gato", "meaning": "貓"}, {"text": "obrigado", "meaning": "謝謝"}]},
  {"id": "pt.letter.a-til", "type": "letter", "text": "ã", "roman": "鼻音 a [ɐ̃]", "name": "嘴半開，氣流同時從鼻子出來", "tts": "maçã", "note": "波浪號 ~ 表示鼻音。\n舌頭不要頂到上顎，結尾沒有 n 的音。", "examples": [{"text": "maçã", "meaning": "蘋果"}, {"text": "irmã", "meaning": "姊妹"}]},
  {"id": "pt.letter.ao-til", "type": "letter", "text": "ão", "roman": "鼻音雙母音 [ɐ̃w̃]", "name": "從鼻音 a 滑向「烏」，全程鼻音", "tts": "pão", "note": "葡語最有代表性的音，接近帶鼻音的「昂嗚」但不收 ng。\n很多名詞以 -ção 結尾。", "examples": [{"text": "pão", "meaning": "麵包"}, {"text": "não", "meaning": "不"}]},
  {"id": "pt.letter.ae-til", "type": "letter", "text": "ãe", "roman": "鼻音雙母音 [ɐ̃j̃]", "name": "從鼻音 a 滑向「衣」，全程鼻音", "tts": "mãe", "note": "常見字不多，mãe 最重要。", "examples": [{"text": "mãe", "meaning": "媽媽"}, {"text": "pães", "meaning": "麵包（複數）"}]},
  {"id": "pt.letter.oe-til", "type": "letter", "text": "õe", "roman": "鼻音雙母音 [õj̃]", "name": "從鼻音 o 滑向「衣」，全程鼻音", "tts": "limões", "note": "幾乎只出現在複數字尾 -ões。\n-ão 結尾的名詞，複數多半變 -ões。", "examples": [{"text": "limões", "meaning": "檸檬（複數）"}, {"text": "corações", "meaning": "心（複數）"}]},
  {"id": "pt.letter.an", "type": "letter", "text": "an／am", "roman": "子音前的鼻音 a", "name": "n、m 不獨立發音，只讓 a 變成鼻音", "tts": "samba", "note": "出現在子音前：sam-ba、can-to。\n動詞字尾的 -am 讀成像 ão 的弱音：falam。", "examples": [{"text": "samba", "meaning": "森巴"}, {"text": "canto", "meaning": "歌、角落"}]},
  {"id": "pt.letter.en", "type": "letter", "text": "en／em", "roman": "鼻音 e [ẽ]；字尾 -em 讀 [ẽj̃]", "name": "n、m 不獨立發音；字尾 -em 帶一點「衣」的尾音", "tts": "bem", "note": "字尾 -em 聽起來接近帶鼻音的「欸衣」：bem、também。", "examples": [{"text": "bem", "meaning": "好"}, {"text": "tempo", "meaning": "時間"}]},
  {"id": "pt.letter.in", "type": "letter", "text": "in／im", "roman": "鼻音 i [ĩ]", "name": "帶鼻音的「衣」，嘴唇不閉", "tts": "sim", "note": "sim 的結尾不要把嘴唇閉起來。", "examples": [{"text": "sim", "meaning": "是"}, {"text": "lindo", "meaning": "漂亮"}]},
  {"id": "pt.letter.on", "type": "letter", "text": "on／om", "roman": "鼻音 o [õ]", "name": "帶鼻音的閉口 o，嘴唇不閉", "tts": "bom", "note": "bom 聽起來接近帶鼻音的「蹦」，但嘴唇不閉、不收 ng。", "examples": [{"text": "bom", "meaning": "好"}, {"text": "onde", "meaning": "哪裡"}]},
  {"id": "pt.letter.un", "type": "letter", "text": "un／um", "roman": "鼻音 u [ũ]", "name": "帶鼻音的「烏」，嘴唇不閉", "tts": "um", "note": "數字「一」um 就是這個音。", "examples": [{"text": "um", "meaning": "一"}, {"text": "mundo", "meaning": "世界"}]}
]
