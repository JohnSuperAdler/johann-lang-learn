[
  {"id": "pt.word.paranaue-paranaue-parana", "type": "word", "text": "Paranauê paranauê Paraná", "ipa": "paɾanaˈwe paɾaˈna", "pos": "expr.", "meaning": "巴拉納威（最廣為人知的副歌）", "note": "眾人回唱的部分。Paraná 是巴西南部的河流與州名。", "examples": [{"text": "Vou dizer minha mulher Paraná", "meaning": "我要告訴我的妻子，巴拉納"}]},
  {"id": "pt.word.zum-zum-zum-capoeira-mata-um", "type": "word", "text": "Zum zum zum capoeira mata um", "ipa": "zũ zũ zũ kapuˈejɾɐ ˈmatɐ ũ", "pos": "expr.", "meaning": "嗡嗡嗡，卡波耶拉能撂倒一個人", "note": "領唱與回唱是同一句。mata 是 matar（殺）的現在式，這裡是誇飾。", "examples": [{"text": "Zum zum zum capoeira mata um", "meaning": "嗡嗡嗡，卡波耶拉能撂倒一個人"}]},
  {"id": "pt.word.sai-sai-catarina", "type": "word", "text": "Sai sai Catarina", "ipa": "saj saj kataˈɾinɐ", "pos": "expr.", "meaning": "出來吧，卡塔琳娜", "note": "sai 是 sair（出去）的命令式。", "examples": [{"text": "Saia do mar venha ver Idalina", "meaning": "從海裡出來，來看伊達莉娜"}]},
  {"id": "pt.word.marinheiro-so", "type": "word", "text": "Marinheiro só", "ipa": "maɾiˈɲejɾu sɔ", "pos": "expr.", "meaning": "孤單的水手", "note": "回唱句。領唱每唱一句，眾人就回 Marinheiro só。", "examples": [{"text": "Eu não sou daqui", "meaning": "我不是這裡的人"}]},
  {"id": "pt.word.ie-viva-meu-mestre", "type": "word", "text": "Iê viva meu mestre", "ipa": "iˈe ˈvivɐ mew ˈmɛstɾi", "pos": "expr.", "meaning": "耶，我的師父萬歲", "note": "致敬段的句型：Iê viva ＋ 致敬的對象，眾人重複並加上 camará。", "examples": [{"text": "Iê viva meu mestre camará", "meaning": "耶，我的師父萬歲，夥伴"}]},
  {"id": "pt.word.volta-do-mundo", "type": "word", "text": "Volta do mundo", "ipa": "ˈvɔwtɐ du ˈmũdu", "pos": "expr.", "meaning": "繞世界一圈（兩人繞場走）", "note": "唱到這句時，對練的兩人常停下來繞著圈走。", "examples": [{"text": "Iê volta do mundo camará", "meaning": "耶，繞世界一圈，夥伴"}]},
  {"id": "pt.word.quem-vem-la-sou-eu", "type": "word", "text": "Quem vem lá sou eu", "ipa": "kẽj̃ vẽj̃ la sow ew", "pos": "expr.", "meaning": "來的人就是我", "examples": [{"text": "Quem vem lá sou eu berimbau bateu", "meaning": "來的人就是我，弓琴響了"}]},
  {"id": "pt.word.adeus-adeus-boa-viagem", "type": "word", "text": "Adeus adeus boa viagem", "ipa": "aˈdews ˈboɐ viˈaʒẽj̃", "pos": "expr.", "meaning": "再見再見，一路順風", "note": "roda 結束時常唱的曲子。", "examples": [{"text": "Eu vou-me embora boa viagem", "meaning": "我要走了，一路順風"}]},
  {"id": "pt.word.mar", "type": "word", "text": "mar", "ipa": "maɾ", "pos": "n.m.", "meaning": "海", "note": "歌裡的海常指橫渡大西洋的記憶。", "examples": [{"text": "O navio está no mar", "meaning": "船在海上"}]},
  {"id": "pt.word.marinheiro", "type": "word", "text": "marinheiro", "ipa": "maɾiˈɲejɾu", "pos": "n.m.", "meaning": "水手", "examples": [{"text": "O marinheiro vive no mar", "meaning": "水手在海上生活"}]},
  {"id": "pt.word.bahia", "type": "word", "text": "Bahia", "ipa": "baˈiɐ", "pos": "n.f.", "meaning": "巴伊亞（卡波耶拉的發源地）", "note": "h 不發音，三個音節：Ba-I-a。首府是薩爾瓦多。", "examples": [{"text": "Eu vou para a Bahia", "meaning": "我要去巴伊亞"}]},
  {"id": "pt.word.terra", "type": "word", "text": "terra", "ipa": "ˈtɛhɐ", "pos": "n.f.", "meaning": "土地、故鄉", "note": "rr 讀 [h]。", "examples": [{"text": "Tenho saudade da minha terra", "meaning": "我想念我的故鄉"}]},
  {"id": "pt.word.vento", "type": "word", "text": "vento", "ipa": "ˈvẽtu", "pos": "n.m.", "meaning": "風", "examples": [{"text": "O vento balança o coqueiro", "meaning": "風搖動椰子樹"}]},
  {"id": "pt.word.deus", "type": "word", "text": "Deus", "ipa": "dews", "pos": "n.m.", "meaning": "上帝、神", "examples": [{"text": "Deus me ajuda no jogo", "meaning": "上帝在對練裡幫助我"}]},
  {"id": "pt.word.saudade", "type": "word", "text": "saudade", "ipa": "sawˈdadʒi", "pos": "n.f.", "meaning": "思念、懷念", "note": "葡語的代表詞：想念不在身邊的人、地方或時光。", "examples": [{"text": "Eu tenho saudade do meu mestre", "meaning": "我想念我的師父"}]},
  {"id": "pt.word.liberdade", "type": "word", "text": "liberdade", "ipa": "libeɾˈdadʒi", "pos": "n.f.", "meaning": "自由", "examples": [{"text": "A capoeira é luta de liberdade", "meaning": "卡波耶拉是爭取自由的抗爭"}]},
  {"id": "pt.word.luta", "type": "word", "text": "luta", "ipa": "ˈlutɐ", "pos": "n.f.", "meaning": "戰鬥、抗爭、武術", "examples": [{"text": "Capoeira é luta e é dança", "meaning": "卡波耶拉是武術也是舞蹈"}]},
  {"id": "pt.word.cantar", "type": "word", "text": "cantar", "ipa": "kɐ̃ˈtaɾ", "pos": "v.", "meaning": "唱歌", "examples": [{"text": "Todo mundo precisa cantar o coro", "meaning": "每個人都要唱回應句"}]},
  {"id": "pt.word.jogar", "type": "word", "text": "jogar", "ipa": "ʒoˈɡaɾ", "pos": "v.", "meaning": "對練（玩卡波耶拉）", "note": "卡波耶拉用 jogar（玩），不用 lutar（打）。", "examples": [{"text": "Eu quero jogar com você", "meaning": "我想和你對練"}]},
  {"id": "pt.word.tocar", "type": "word", "text": "tocar", "ipa": "toˈkaɾ", "pos": "v.", "meaning": "彈奏（樂器）", "note": "也有「觸碰」的意思。", "examples": [{"text": "Eu quero aprender a tocar berimbau", "meaning": "我想學彈弓琴"}]},
  {"id": "pt.word.bater-palmas", "type": "word", "text": "bater palmas", "ipa": "baˈteɾ ˈpawmɐs", "pos": "expr.", "meaning": "拍手打拍子", "examples": [{"text": "Vamos bater palmas no ritmo", "meaning": "我們跟著節奏拍手吧"}]},
  {"id": "pt.word.vou-me-embora", "type": "word", "text": "vou-me embora", "ipa": "ˈvow mi ẽˈbɔɾɐ", "pos": "expr.", "meaning": "我要走了", "accepted": ["vou me embora"], "note": "ir embora＝離開。口語說 vou embora。", "examples": [{"text": "Eu já vou-me embora camará", "meaning": "我這就要走了，夥伴"}]},
  {"id": "pt.word.a-hora-e-essa", "type": "word", "text": "a hora é essa", "ipa": "a ˈɔɾɐ ɛ ˈɛsɐ", "pos": "expr.", "meaning": "就是現在、時候到了", "examples": [{"text": "A hora é essa vamos jogar", "meaning": "時候到了，我們來對練"}]},
  {"id": "pt.word.e-de-manha", "type": "word", "text": "é de manhã", "ipa": "ɛ dʒi mɐˈɲɐ̃", "pos": "expr.", "meaning": "天亮了、現在是早上", "examples": [{"text": "É de manhã eu vou jogar", "meaning": "天亮了，我要去對練"}]},
  {"id": "pt.word.da-licenca", "type": "word", "text": "dá licença", "ipa": "da liˈsẽsɐ", "pos": "expr.", "meaning": "借個光、請讓我進來", "note": "進圈前向弓琴與在場者致意的說法。", "examples": [{"text": "Dá licença para eu passar", "meaning": "請借過讓我通過"}]}
]
