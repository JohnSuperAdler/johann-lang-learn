[
  {"id": "pt.letter.lh", "type": "letter", "text": "lh", "roman": "[ʎ]，接近「利」＋母音", "name": "舌面貼上顎發的 l", "tts": "filho", "note": "接近快速唸的「li」＋後面的母音：filho 像「fi-lyu」。", "examples": [{"text": "filho", "meaning": "兒子"}, {"text": "trabalho", "meaning": "工作"}]},
  {"id": "pt.letter.nh", "type": "letter", "text": "nh", "roman": "[ɲ]，接近「尼」＋母音", "name": "舌面貼上顎發的 n", "tts": "banho", "note": "等於西班牙語的 ñ：banho 像「ba-nyu」。", "examples": [{"text": "banho", "meaning": "洗澡"}, {"text": "amanhã", "meaning": "明天"}]},
  {"id": "pt.letter.c-cedilha", "type": "letter", "text": "ç", "roman": "[s]，只出現在 a o u 前", "name": "加了軟音符號的 c，一律讀 [s]", "tts": "cabeça", "note": "不會出現在字首，也不會出現在 e、i 前。", "examples": [{"text": "cabeça", "meaning": "頭"}, {"text": "açúcar", "meaning": "糖"}]},
  {"id": "pt.letter.ch", "type": "letter", "text": "ch", "roman": "[ʃ]，像英語 sh", "name": "不是英語 ch 的音", "tts": "chuva", "note": "嘴唇微微噘起。", "examples": [{"text": "chuva", "meaning": "雨"}, {"text": "chave", "meaning": "鑰匙"}]},
  {"id": "pt.letter.x-inicial", "type": "letter", "text": "x-", "roman": "字首的 x 讀 [ʃ]", "name": "與 ch 同音", "tts": "xícara", "note": "字首的 x 讀音與 ch 相同。", "examples": [{"text": "xícara", "meaning": "杯子"}, {"text": "xadrez", "meaning": "西洋棋"}]},
  {"id": "pt.letter.ge-gi", "type": "letter", "text": "ge／gi", "roman": "[ʒ]，與 j 同音", "name": "e、i 前的 g 變成軟音", "tts": "gente", "note": "像英語 measure 的 s。ga、go、gu 仍讀 [g]。", "examples": [{"text": "gente", "meaning": "人們"}, {"text": "girar", "meaning": "旋轉"}]},
  {"id": "pt.letter.qu", "type": "letter", "text": "que／qui", "roman": "[k]，u 不發音", "name": "que 讀「ke」，qui 讀「ki」", "tts": "quero", "note": "qua、quo 的 u 則要發音：quando、quatro。", "examples": [{"text": "quero", "meaning": "我想要"}, {"text": "aqui", "meaning": "這裡"}]},
  {"id": "pt.letter.gu", "type": "letter", "text": "gue／gui", "roman": "[g]，u 不發音", "name": "gue 讀「ge」，gui 讀「gi」（硬音 g）", "tts": "guerra", "note": "u 的作用是讓 g 保持硬音。gua 的 u 則要發音：água。", "examples": [{"text": "guerra", "meaning": "戰爭"}, {"text": "guitarra", "meaning": "吉他"}]},
  {"id": "pt.letter.r-inicial", "type": "letter", "text": "r-", "roman": "字首的 r 讀 [h]", "name": "像英語的 h，從喉嚨出氣", "tts": "rua", "note": "roda 讀作「hoda」、Rio 讀作「hiu」。", "examples": [{"text": "rua", "meaning": "街道"}, {"text": "roda", "meaning": "圈、輪子"}]},
  {"id": "pt.letter.rr", "type": "letter", "text": "rr", "roman": "[h]，與字首 r 同音", "name": "只出現在兩個母音之間", "tts": "carro", "note": "carro（車）與 caro（貴）靠這個音區分。", "examples": [{"text": "carro", "meaning": "車"}, {"text": "berro", "meaning": "吼叫"}]},
  {"id": "pt.letter.r-medio", "type": "letter", "text": "-r-", "roman": "母音之間的彈舌 [ɾ]", "name": "舌尖輕彈上齒齦一下", "tts": "caro", "note": "類似美式英語 water 中間的 t。\n子音後的 r（br、tr、pr）也是這個音。", "examples": [{"text": "caro", "meaning": "貴"}, {"text": "capoeira", "meaning": "卡波耶拉"}]},
  {"id": "pt.letter.s-medio", "type": "letter", "text": "-s-", "roman": "母音之間的 s 讀 [z]", "name": "單一 s 夾在兩個母音中間", "tts": "casa", "note": "要保持 [s] 就寫成 ss：passo。", "examples": [{"text": "casa", "meaning": "家"}, {"text": "mesa", "meaning": "桌子"}]},
  {"id": "pt.letter.l-final", "type": "letter", "text": "-l", "roman": "音節尾的 l 讀 [w]", "name": "像「烏」的短音", "tts": "Brasil", "note": "Brasil 讀作「Braziu」、legal 讀作「legau」。", "examples": [{"text": "Brasil", "meaning": "巴西"}, {"text": "legal", "meaning": "很棒"}]},
  {"id": "pt.letter.ti", "type": "letter", "text": "ti／-te", "roman": "[tʃi]，接近「七」", "name": "i 與非重讀字尾 e 前的 t 顎化", "tts": "leite", "note": "leite 讀作「lei-chi」、tia 讀作「chi-a」。\n巴西東北部分地區不顎化。", "examples": [{"text": "leite", "meaning": "牛奶"}, {"text": "tia", "meaning": "阿姨"}]},
  {"id": "pt.letter.di", "type": "letter", "text": "di／-de", "roman": "[dʒi]，接近「機」", "name": "i 與非重讀字尾 e 前的 d 顎化", "tts": "dia", "note": "dia 讀作「ji-a」、cidade 讀作「si-da-ji」。", "examples": [{"text": "dia", "meaning": "日子"}, {"text": "cidade", "meaning": "城市"}]}
]
