[
  {"id": "pt.grammar.adjetivo", "type": "grammar", "title": "形容詞的性數一致與位置", "pattern": "名詞 ＋ 形容詞；-o → -a，複數加 s", "explanation": "形容詞通常放在名詞後面，並且跟名詞的性別與單複數一致。以 -o 結尾的形容詞，陰性改成 -a。以 -e 或子音結尾的多半男女同形（grande、feliz、legal）。少數常用形容詞可放前面：bom、grande、novo。", "examples": [{"text": "um jogo bonito", "meaning": "一場漂亮的對練"}, {"text": "uma música bonita", "meaning": "一首好聽的歌"}, {"text": "amigos brasileiros", "meaning": "巴西朋友們"}, {"text": "uma roda grande", "meaning": "一個大圈"}], "pitfalls": ["照中文或英語的順序放在前面：um bonito jogo", "形容詞沒跟著變：uma música bonito"], "drills": [{"type": "fill", "text": "uma casa ___（pequeno）", "answer": "pequena"}, {"type": "fill", "text": "dois amigos ___（brasileiro）", "answer": "brasileiros"}, {"type": "choice", "text": "uma roda ___", "answer": "grande", "options": ["grande", "granda", "grando"]}, {"type": "reorder", "text": "一首好聽的歌", "answer": "uma música muito bonita"}, {"type": "choice", "text": "葡語形容詞通常放在名詞的？", "answer": "後面", "options": ["後面", "前面"]}]},
  {"id": "pt.grammar.bom-mau", "type": "grammar", "title": "bom／boa 與 muito", "pattern": "bom（陽）／boa（陰）；muito ＋ 形容詞", "explanation": "bom（好）是不規則形容詞：陰性 boa，複數 bons、boas。muito 放在形容詞前面表示「很」，這時不變化。muito 放在名詞前面表示「很多」，要跟名詞一致：muita gente、muitos amigos。", "examples": [{"text": "um bom mestre", "meaning": "一位好師父"}, {"text": "uma boa aula", "meaning": "一堂好課"}, {"text": "muito bom", "meaning": "非常好"}, {"text": "muita gente", "meaning": "很多人"}], "pitfalls": ["陰性寫成 boma 或 bona", "「很」的 muito 跟著變：muita bonita"], "drills": [{"type": "fill", "text": "___ noite（晚安）", "answer": "boa"}, {"type": "fill", "text": "___ dia（早安）", "answer": "bom"}, {"type": "choice", "text": "Ela canta ___ bem", "answer": "muito", "options": ["muito", "muita", "muitos"]}, {"type": "choice", "text": "Tem ___ gente na roda", "answer": "muita", "options": ["muita", "muito", "muitos"]}]},
  {"id": "pt.grammar.demonstrativos", "type": "grammar", "title": "指示詞 este／esse／aquele", "pattern": "este ＝ 這（近我）　esse ＝ 那（近你）　aquele ＝ 那（都遠）", "explanation": "指示詞依距離分三級，並且有陰性與複數形：este／esta、esse／essa、aquele／aquela。巴西口語中 esse 常同時取代 este。不指明名詞時用中性的 isto、isso、aquilo（這個、那個東西）。", "examples": [{"text": "Este berimbau é meu", "meaning": "這把弓琴是我的"}, {"text": "Essa música é linda", "meaning": "那首歌很美"}, {"text": "Aquele homem é o mestre", "meaning": "那邊那個男人是師父"}, {"text": "O que é isso?", "meaning": "那是什麼？"}], "pitfalls": ["陰性名詞前用陽性形：este casa", "把 isso 放在名詞前：isso música"], "drills": [{"type": "fill", "text": "___ casa é minha（這間房子，近我）", "answer": "esta"}, {"type": "fill", "text": "___ homem é meu pai（那邊那個男人）", "answer": "aquele"}, {"type": "choice", "text": "O que é ___?（那是什麼？）", "answer": "isso", "options": ["isso", "esse", "essa"]}, {"type": "choice", "text": "___ música é bonita", "answer": "essa", "options": ["essa", "esse", "isso"]}, {"type": "reorder", "text": "這把弓琴是我的", "answer": "este berimbau é meu"}]},
  {"id": "pt.grammar.possessivos", "type": "grammar", "title": "所有格 meu／minha、seu／sua", "pattern": "meu／minha ＝ 我的　seu／sua ＝ 你的　nosso／nossa ＝ 我們的", "explanation": "所有格跟「被擁有的東西」的性別一致，與擁有者的性別無關：男生也說 minha mãe。「他的、她的」在口語中多用 dele、dela，放在名詞後面：o amigo dele。", "examples": [{"text": "meu mestre", "meaning": "我的師父"}, {"text": "minha mãe", "meaning": "我的媽媽"}, {"text": "seu nome", "meaning": "你的名字"}, {"text": "nossa roda", "meaning": "我們的圈"}, {"text": "o berimbau dela", "meaning": "她的弓琴"}], "pitfalls": ["依說話者性別選：男生說 meu mãe", "dele 放在名詞前面：dele amigo"], "drills": [{"type": "fill", "text": "___ pai é professor（我的爸爸）", "answer": "meu"}, {"type": "fill", "text": "___ irmã mora aqui（我的姊妹）", "answer": "minha"}, {"type": "choice", "text": "Qual é o ___ nome?（你的名字）", "answer": "seu", "options": ["seu", "sua", "dele"]}, {"type": "reorder", "text": "我的師父很棒", "answer": "meu mestre é muito bom"}]}
]
