[
  {"id": "pt.letter.a", "type": "letter", "text": "a", "roman": "á", "name": "母音，嘴張大的「啊」", "tts": "á", "note": "重讀時是開口的 [a]。\n非重讀的字尾 a 較弱、較短。", "examples": [{"text": "amigo", "meaning": "朋友"}, {"text": "casa", "meaning": "家"}]},
  {"id": "pt.letter.b", "type": "letter", "text": "b", "roman": "bê", "name": "同英語 b", "tts": "bê", "note": "與英語的 b 相同。", "examples": [{"text": "bom", "meaning": "好"}, {"text": "bola", "meaning": "球"}]},
  {"id": "pt.letter.c", "type": "letter", "text": "c", "roman": "cê", "name": "a o u 前讀 [k]，e i 前讀 [s]", "tts": "cê", "note": "ca、co、cu 讀 [k]；ce、ci 讀 [s]。\n加上軟音符號的 ç 一律讀 [s]。", "examples": [{"text": "casa", "meaning": "家"}, {"text": "cidade", "meaning": "城市"}]},
  {"id": "pt.letter.d", "type": "letter", "text": "d", "roman": "dê", "name": "[d]；在 i 與字尾 e 前讀 [dʒ]", "tts": "dê", "note": "巴西多數地區 di、字尾 de 讀成類似「機」的 [dʒi]。", "examples": [{"text": "dia", "meaning": "日子"}, {"text": "dedo", "meaning": "手指"}]},
  {"id": "pt.letter.e", "type": "letter", "text": "e", "roman": "é", "name": "母音，有開口 [ɛ] 與閉口 [e] 兩種", "tts": "é", "note": "é 是開口，ê 是閉口。\n非重讀的字尾 e 讀成 [i]。", "examples": [{"text": "ele", "meaning": "他"}, {"text": "café", "meaning": "咖啡"}]},
  {"id": "pt.letter.f", "type": "letter", "text": "f", "roman": "efe", "name": "同英語 f", "tts": "efe", "note": "與英語的 f 相同。", "examples": [{"text": "festa", "meaning": "派對"}, {"text": "fogo", "meaning": "火"}]},
  {"id": "pt.letter.g", "type": "letter", "text": "g", "roman": "gê", "name": "a o u 前讀 [g]，e i 前讀 [ʒ]", "tts": "gê", "note": "ga、go、gu 讀 [g]；ge、gi 讀 [ʒ]（像英語 measure 的 s）。", "examples": [{"text": "gato", "meaning": "貓"}, {"text": "gente", "meaning": "人們"}]},
  {"id": "pt.letter.h", "type": "letter", "text": "h", "roman": "agá", "name": "字首不發音", "tts": "agá", "note": "字首的 h 完全不發音：hoje 讀作「oje」。\n只在 ch、lh、nh 三個組合裡改變前一個字母的音。", "examples": [{"text": "hoje", "meaning": "今天"}, {"text": "hora", "meaning": "小時"}]},
  {"id": "pt.letter.i", "type": "letter", "text": "i", "roman": "i", "name": "母音「衣」", "tts": "i", "note": "永遠是 [i]。", "examples": [{"text": "ilha", "meaning": "島"}, {"text": "vida", "meaning": "生命"}]},
  {"id": "pt.letter.j", "type": "letter", "text": "j", "roman": "jota", "name": "[ʒ]，不是英語的 j", "tts": "jota", "note": "像英語 measure 的 s，舌頭不碰上顎。", "examples": [{"text": "jogo", "meaning": "遊戲、比賽"}, {"text": "janela", "meaning": "窗戶"}]},
  {"id": "pt.letter.k", "type": "letter", "text": "k", "roman": "cá", "name": "[k]，只出現在外來語", "tts": "cá", "note": "只用於外來語、人名與單位符號（km、kg）。", "examples": [{"text": "kiwi", "meaning": "奇異果"}]},
  {"id": "pt.letter.l", "type": "letter", "text": "l", "roman": "ele", "name": "字首同英語 l；音節尾讀 [w]", "tts": "ele", "note": "音節尾的 l 讀成 [w]：Brasil 讀作「Braziu」。", "examples": [{"text": "lua", "meaning": "月亮"}, {"text": "Brasil", "meaning": "巴西"}]},
  {"id": "pt.letter.m", "type": "letter", "text": "m", "roman": "eme", "name": "[m]；字尾使前面的母音鼻化", "tts": "eme", "note": "字尾的 m 不閉唇，只把前面的母音變成鼻音：bom、sim。", "examples": [{"text": "mãe", "meaning": "媽媽"}, {"text": "bom", "meaning": "好"}]},
  {"id": "pt.letter.n", "type": "letter", "text": "n", "roman": "ene", "name": "[n]；子音前使母音鼻化", "tts": "ene", "note": "在子音前不獨立發音，只讓前面的母音鼻化：canto。", "examples": [{"text": "nome", "meaning": "名字"}, {"text": "canto", "meaning": "歌、角落"}]},
  {"id": "pt.letter.o", "type": "letter", "text": "o", "roman": "ó", "name": "母音，有開口 [ɔ] 與閉口 [o] 兩種", "tts": "ó", "note": "ó 是開口，ô 是閉口。\n非重讀的字尾 o 讀成 [u]。", "examples": [{"text": "ovo", "meaning": "蛋"}, {"text": "avó", "meaning": "祖母"}]},
  {"id": "pt.letter.p", "type": "letter", "text": "p", "roman": "pê", "name": "同英語 p，但不送氣", "tts": "pê", "note": "氣流比英語的 p 弱。", "examples": [{"text": "pai", "meaning": "爸爸"}, {"text": "pé", "meaning": "腳"}]},
  {"id": "pt.letter.q", "type": "letter", "text": "q", "roman": "quê", "name": "一定與 u 連用，讀 [k] 或 [kw]", "tts": "quê", "note": "que、qui 的 u 不發音，讀 [k]；qua、quo 讀 [kw]。", "examples": [{"text": "quero", "meaning": "我想要"}, {"text": "quando", "meaning": "什麼時候"}]},
  {"id": "pt.letter.r", "type": "letter", "text": "r", "roman": "erre", "name": "字首讀 [h]；母音之間是彈舌 [ɾ]", "tts": "erre", "note": "字首的 r 與 rr 像英語的 h。\n兩個母音之間的單一 r 是舌尖輕彈一下。", "examples": [{"text": "rua", "meaning": "街道"}, {"text": "caro", "meaning": "貴"}]},
  {"id": "pt.letter.s", "type": "letter", "text": "s", "roman": "esse", "name": "[s]；兩個母音之間讀 [z]", "tts": "esse", "note": "字首與 ss 讀 [s]；兩個母音之間的單一 s 讀 [z]：casa。", "examples": [{"text": "sol", "meaning": "太陽"}, {"text": "casa", "meaning": "家"}]},
  {"id": "pt.letter.t", "type": "letter", "text": "t", "roman": "tê", "name": "[t]；在 i 與字尾 e 前讀 [tʃ]", "tts": "tê", "note": "巴西多數地區 ti、字尾 te 讀成類似「七」的 [tʃi]。", "examples": [{"text": "tudo", "meaning": "全部"}, {"text": "leite", "meaning": "牛奶"}]},
  {"id": "pt.letter.u", "type": "letter", "text": "u", "roman": "u", "name": "母音「烏」", "tts": "u", "note": "永遠是 [u]。que、qui、gue、gui 裡的 u 不發音。", "examples": [{"text": "uva", "meaning": "葡萄"}, {"text": "tudo", "meaning": "全部"}]},
  {"id": "pt.letter.v", "type": "letter", "text": "v", "roman": "vê", "name": "同英語 v", "tts": "vê", "note": "上齒輕咬下唇，與 b 要分清楚。", "examples": [{"text": "você", "meaning": "你"}, {"text": "vida", "meaning": "生命"}]},
  {"id": "pt.letter.w", "type": "letter", "text": "w", "roman": "dáblio", "name": "只出現在外來語", "tts": "dáblio", "note": "只用於外來語與人名，讀 [w] 或 [v]。", "examples": [{"text": "web", "meaning": "網路"}, {"text": "show", "meaning": "表演"}]},
  {"id": "pt.letter.x", "type": "letter", "text": "x", "roman": "xis", "name": "最常讀 [ʃ]，也有 [s]、[z]、[ks]", "tts": "xis", "note": "字首幾乎都讀 [ʃ]（像英語 sh）。\n其他位置要逐字記：exame [z]、táxi [ks]、próximo [s]。", "examples": [{"text": "xícara", "meaning": "杯子"}, {"text": "táxi", "meaning": "計程車"}]},
  {"id": "pt.letter.y", "type": "letter", "text": "y", "roman": "ípsilon", "name": "只出現在外來語", "tts": "ípsilon", "note": "只用於外來語與人名，讀 [i]。", "examples": [{"text": "yoga", "meaning": "瑜伽"}]},
  {"id": "pt.letter.z", "type": "letter", "text": "z", "roman": "zê", "name": "[z]；字尾讀 [s]", "tts": "zê", "note": "字尾的 z 在巴西多數地區讀 [s]：feliz。", "examples": [{"text": "zero", "meaning": "零"}, {"text": "feliz", "meaning": "快樂"}]}
]
