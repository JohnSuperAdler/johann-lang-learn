[
  {"id": "pt.grammar.genero", "type": "grammar", "title": "名詞的性別", "pattern": "-o 多為陽性　-a 多為陰性", "explanation": "葡語每個名詞都有性別。以 -o 結尾的多半是陽性，以 -a 結尾的多半是陰性。以 -ção、-dade、-gem 結尾的是陰性。少數例外要另外記：o dia（日子）、o mapa（地圖）是陽性，a mão（手）是陰性。性別會影響冠詞與形容詞的形式。", "examples": [{"text": "o menino", "meaning": "男孩（陽性）"}, {"text": "a menina", "meaning": "女孩（陰性）"}, {"text": "a cidade", "meaning": "城市（-dade 陰性）"}, {"text": "o dia", "meaning": "日子（例外，陽性）"}], "pitfalls": ["看到 -a 結尾就當陰性：o dia、o problema 是陽性", "以為性別只和人或動物有關，其實每個名詞都有"], "drills": [{"type": "choice", "text": "casa（家）的性別是？", "answer": "陰性", "options": ["陰性", "陽性"]}, {"type": "choice", "text": "dia（日子）的性別是？", "answer": "陽性", "options": ["陽性", "陰性"]}, {"type": "choice", "text": "以 -ção 結尾的名詞（如 canção）是？", "answer": "陰性", "options": ["陰性", "陽性"]}, {"type": "choice", "text": "哪一個是陽性名詞？", "answer": "livro", "options": ["livro", "mesa", "cidade"]}]},
  {"id": "pt.grammar.artigo-definido", "type": "grammar", "title": "定冠詞 o／a／os／as", "pattern": "o ＋ 陽性單數　a ＋ 陰性單數　os／as ＋ 複數", "explanation": "定冠詞相當於英語的 the，要跟名詞的性別和單複數一致。葡語用定冠詞的場合比英語多：所有格前面、人名前面在口語中也常加（o meu pai、a Ana）。", "examples": [{"text": "o berimbau", "meaning": "那把弓琴"}, {"text": "a roda", "meaning": "那個圈"}, {"text": "os alunos", "meaning": "那些學生"}, {"text": "as músicas", "meaning": "那些歌"}], "pitfalls": ["冠詞性別配錯：a berimbau", "複數名詞前忘了把冠詞也變複數"], "drills": [{"type": "fill", "text": "___ menino joga bola（那個男孩踢球）", "answer": "o"}, {"type": "fill", "text": "___ casa é grande（那間房子很大）", "answer": "a"}, {"type": "fill", "text": "___ amigos chegaram（那些朋友到了）", "answer": "os"}, {"type": "choice", "text": "___ mãos（那雙手）", "answer": "as", "options": ["as", "os", "a"]}, {"type": "reorder", "text": "那位師父彈弓琴", "answer": "o mestre toca berimbau"}]},
  {"id": "pt.grammar.artigo-indefinido", "type": "grammar", "title": "不定冠詞 um／uma", "pattern": "um ＋ 陽性　uma ＋ 陰性　uns／umas ＝ 一些", "explanation": "不定冠詞相當於英語的 a／an，同時也是數字「一」。陽性用 um，陰性用 uma。複數 uns、umas 表示「一些」。", "examples": [{"text": "um café", "meaning": "一杯咖啡"}, {"text": "uma água", "meaning": "一瓶水"}, {"text": "uns amigos", "meaning": "一些朋友"}], "pitfalls": ["陰性名詞前用 um：um casa", "把 um 的 m 讀成閉唇的 m，其實是鼻音"], "drills": [{"type": "fill", "text": "Eu quero ___ café（我要一杯咖啡）", "answer": "um"}, {"type": "fill", "text": "Eu tenho ___ irmã（我有一個姊妹）", "answer": "uma"}, {"type": "choice", "text": "___ cerveja, por favor", "answer": "uma", "options": ["uma", "um", "uns"]}, {"type": "reorder", "text": "我有一個朋友", "answer": "eu tenho um amigo"}]},
  {"id": "pt.grammar.plural", "type": "grammar", "title": "複數規則", "pattern": "母音 ＋ s　-r／-z ＋ es　-ão → -ões　-l → -is　-m → -ns", "explanation": "以母音結尾的名詞直接加 s。以 r、z 結尾加 es。以 -ão 結尾的多數變成 -ões（少數變 -ães 或 -ãos）。以 -al、-el、-ol 結尾的把 l 換成 is。以 -m 結尾的換成 -ns。冠詞與形容詞也要跟著變複數。", "examples": [{"text": "casa → casas", "meaning": "家"}, {"text": "mulher → mulheres", "meaning": "女人"}, {"text": "coração → corações", "meaning": "心"}, {"text": "animal → animais", "meaning": "動物"}, {"text": "homem → homens", "meaning": "男人"}], "pitfalls": ["-ão 的複數直接加 s：coraçãos", "只把名詞變複數，冠詞沒變：o amigos"], "drills": [{"type": "fill", "text": "um amigo → dois ___", "answer": "amigos"}, {"type": "fill", "text": "uma mulher → duas ___", "answer": "mulheres"}, {"type": "fill", "text": "um limão → dois ___", "answer": "limões"}, {"type": "choice", "text": "homem 的複數是？", "answer": "homens", "options": ["homens", "homems", "homemes"]}, {"type": "choice", "text": "animal 的複數是？", "answer": "animais", "options": ["animais", "animals", "animales"]}]}
]
