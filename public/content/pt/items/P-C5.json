[
  {"id": "pt.grammar.perguntas-1", "type": "grammar", "title": "疑問詞：o que、quem、onde", "pattern": "o que ＝ 什麼　quem ＝ 誰　onde ＝ 哪裡", "explanation": "疑問詞放在句首，後面的語序和直述句相同，不需要倒裝或助動詞。一般是非問句也不改語序，只把句尾語調上揚：Você fala português?。口語常在疑問詞後加 é que 加強語氣：O que é que você quer?", "examples": [{"text": "O que você quer?", "meaning": "你想要什麼？"}, {"text": "Quem é ele?", "meaning": "他是誰？"}, {"text": "Onde você mora?", "meaning": "你住在哪裡？"}], "pitfalls": ["套用英語加助動詞：Do você fala?", "onde 與 aonde 混用，aonde 只用在「去哪裡」"], "drills": [{"type": "fill", "text": "___ você mora?（你住在哪裡？）", "answer": "onde"}, {"type": "fill", "text": "___ é o mestre?（師父是誰？）", "answer": "quem"}, {"type": "choice", "text": "___ você quer comer?", "answer": "o que", "options": ["o que", "quem", "onde"]}, {"type": "reorder", "text": "你住在哪裡", "answer": "onde você mora"}, {"type": "reorder", "text": "那個男人是誰", "answer": "quem é aquele homem"}]},
  {"id": "pt.grammar.perguntas-2", "type": "grammar", "title": "疑問詞：quando、como、por que、quanto", "pattern": "quando ＝ 何時　como ＝ 如何　por que ＝ 為什麼　quanto ＝ 多少", "explanation": "quanto 要跟後面的名詞一致：quanto、quanta、quantos、quantas。問原因用分開寫的 por que，回答「因為」用連在一起的 porque。qual（哪一個）用來從選項中挑，問名字、電話也用 qual。", "examples": [{"text": "Quando é a roda?", "meaning": "圈是什麼時候？"}, {"text": "Como você se chama?", "meaning": "你叫什麼名字？"}, {"text": "Por que você treina?", "meaning": "你為什麼練習？"}, {"text": "Quantos anos você tem?", "meaning": "你幾歲？"}], "pitfalls": ["問名字用 o que：O que é seu nome，正確是 Qual é o seu nome", "回答原因寫成分開的 por que"], "drills": [{"type": "fill", "text": "___ é o batizado?（洗禮是什麼時候？）", "answer": "quando"}, {"type": "fill", "text": "___ anos você tem?（你幾歲？）", "answer": "quantos"}, {"type": "choice", "text": "___ você não veio ontem?（為什麼）", "answer": "por que", "options": ["por que", "porque", "como"]}, {"type": "choice", "text": "___ é o seu nome?", "answer": "qual", "options": ["qual", "o que", "quem"]}, {"type": "reorder", "text": "你幾歲", "answer": "quantos anos você tem"}]},
  {"id": "pt.grammar.negacao", "type": "grammar", "title": "não：否定句", "pattern": "主詞 ＋ não ＋ 動詞", "explanation": "把 não 放在動詞前面就是否定句。回答否定時常說兩次：Não, não falo。巴西口語還會在句尾再補一個 não 加強：Não sei não。", "examples": [{"text": "Eu não falo inglês", "meaning": "我不說英語"}, {"text": "Ela não está em casa", "meaning": "她不在家"}, {"text": "Não, eu não quero", "meaning": "不，我不要"}], "pitfalls": ["não 放在動詞後面：Eu falo não inglês", "把 não 讀成「鬧」，其實全程鼻音"], "drills": [{"type": "fill", "text": "Eu ___ como carne（我不吃肉）", "answer": "não"}, {"type": "reorder", "text": "我不說英語", "answer": "eu não falo inglês"}, {"type": "reorder", "text": "她今天不在家", "answer": "ela não está em casa hoje"}, {"type": "choice", "text": "não 要放在哪裡？", "answer": "動詞前面", "options": ["動詞前面", "動詞後面", "句尾"]}]},
  {"id": "pt.grammar.negacao-dupla", "type": "grammar", "title": "nunca、nada、ninguém：雙重否定", "pattern": "não ＋ 動詞 ＋ nada／ninguém／nunca", "explanation": "葡語的雙重否定仍然是否定，而且是標準說法。nada（什麼都沒有）、ninguém（沒有人）放在動詞後面時，動詞前面必須有 não。nunca（從不）可以單獨放在動詞前，也可以說 não … nunca。", "examples": [{"text": "Eu não quero nada", "meaning": "我什麼都不要"}, {"text": "Não tem ninguém aqui", "meaning": "這裡沒有人"}, {"text": "Eu nunca como carne", "meaning": "我從不吃肉"}], "pitfalls": ["照英語只否定一次：Eu quero nada", "以為雙重否定會變成肯定"], "drills": [{"type": "fill", "text": "Eu não sei ___（我什麼都不知道）", "answer": "nada"}, {"type": "fill", "text": "Não tem ___ na roda（圈裡沒有人）", "answer": "ninguém"}, {"type": "fill", "text": "Eu ___ bebo cerveja（我從不喝啤酒）", "answer": "nunca"}, {"type": "choice", "text": "「我什麼都不要」是？", "answer": "Eu não quero nada", "options": ["Eu não quero nada", "Eu quero nada", "Eu não quero tudo"]}, {"type": "reorder", "text": "我什麼都不要", "answer": "eu não quero nada"}]}
]
