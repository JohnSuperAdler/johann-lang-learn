[
  {"id": "pt.grammar.verbo-ar", "type": "grammar", "title": "-ar 動詞現在式", "pattern": "去掉 -ar：eu -o　você／ele -a　nós -amos　vocês／eles -am", "explanation": "葡語動詞依原形字尾分成 -ar、-er、-ir 三類，-ar 最多。以 falar（說）為例：eu falo、você fala、nós falamos、eles falam。卡波耶拉常用的 jogar、cantar、tocar、treinar、gingar 都屬於這一類。", "examples": [{"text": "Eu falo português", "meaning": "我說葡萄牙語"}, {"text": "Ela canta bem", "meaning": "她唱得很好"}, {"text": "Nós treinamos à noite", "meaning": "我們晚上練習"}, {"text": "Eles jogam capoeira", "meaning": "他們玩卡波耶拉"}], "pitfalls": ["eu 形用了 -a：Eu fala", "-am 讀成重音在後，其實重音在字根：FA-lam"], "drills": [{"type": "fill", "text": "Eu ___ português（falar）", "answer": "falo"}, {"type": "fill", "text": "Ela ___ muito bem（cantar）", "answer": "canta"}, {"type": "fill", "text": "Nós ___ na terça-feira（treinar）", "answer": "treinamos"}, {"type": "fill", "text": "Eles ___ berimbau（tocar）", "answer": "tocam"}, {"type": "choice", "text": "Você ___ capoeira?", "answer": "joga", "options": ["joga", "jogo", "jogam"]}]},
  {"id": "pt.grammar.gostar-de", "type": "grammar", "title": "gostar de：喜歡", "pattern": "gostar de ＋ 名詞／動詞原形", "explanation": "gostar（喜歡）是規則的 -ar 動詞，但後面一定要接介系詞 de。de 遇到定冠詞會縮合：de ＋ o ＝ do、de ＋ a ＝ da。", "examples": [{"text": "Eu gosto de música", "meaning": "我喜歡音樂"}, {"text": "Ela gosta de cantar", "meaning": "她喜歡唱歌"}, {"text": "Nós gostamos do Brasil", "meaning": "我們喜歡巴西"}], "pitfalls": ["漏掉 de：Eu gosto música", "de 和冠詞沒有縮合：gosto de o Brasil"], "drills": [{"type": "fill", "text": "Eu gosto ___ capoeira（我喜歡卡波耶拉）", "answer": "de"}, {"type": "fill", "text": "Ela ___ de dançar（她喜歡跳舞）", "answer": "gosta"}, {"type": "choice", "text": "Nós gostamos ___ Brasil", "answer": "do", "options": ["do", "de", "da"]}, {"type": "reorder", "text": "我喜歡巴西音樂", "answer": "eu gosto de música brasileira"}]},
  {"id": "pt.grammar.verbo-er", "type": "grammar", "title": "-er 動詞現在式", "pattern": "去掉 -er：eu -o　você／ele -e　nós -emos　vocês／eles -em", "explanation": "以 comer（吃）為例：eu como、você come、nós comemos、eles comem。常用的還有 beber（喝）、aprender（學）、correr（跑）、entender（懂）。", "examples": [{"text": "Eu como arroz", "meaning": "我吃飯"}, {"text": "Você bebe café?", "meaning": "你喝咖啡嗎？"}, {"text": "Nós aprendemos português", "meaning": "我們學葡萄牙語"}, {"text": "Eles correm na praia", "meaning": "他們在海灘跑步"}], "pitfalls": ["套用 -ar 的字尾：ele coma", "nós 形寫成 -amos：nós comamos"], "drills": [{"type": "fill", "text": "Eu ___ pão de manhã（comer）", "answer": "como"}, {"type": "fill", "text": "Ele ___ muita água（beber）", "answer": "bebe"}, {"type": "fill", "text": "Nós ___ capoeira（aprender）", "answer": "aprendemos"}, {"type": "fill", "text": "Vocês ___ português?（entender）", "answer": "entendem"}, {"type": "choice", "text": "Ela ___ todo dia", "answer": "corre", "options": ["corre", "corro", "correm"]}]},
  {"id": "pt.grammar.verbo-ir", "type": "grammar", "title": "-ir 動詞現在式", "pattern": "去掉 -ir：eu -o　você／ele -e　nós -imos　vocês／eles -em", "explanation": "以 abrir（打開）為例：eu abro、você abre、nós abrimos、eles abrem。和 -er 動詞只差在 nós 形：-emos 對 -imos。常用的還有 partir（離開）、assistir（觀看）、dividir（分）。", "examples": [{"text": "Eu abro a porta", "meaning": "我開門"}, {"text": "Ela abre a roda", "meaning": "她開圈"}, {"text": "Nós assistimos a roda", "meaning": "我們觀看那場圈"}, {"text": "Eles partem amanhã", "meaning": "他們明天出發"}], "pitfalls": ["nós 形用了 -emos：nós abremos"], "drills": [{"type": "fill", "text": "Eu ___ a janela（abrir）", "answer": "abro"}, {"type": "fill", "text": "O mestre ___ a roda（abrir）", "answer": "abre"}, {"type": "fill", "text": "Nós ___ amanhã（partir）", "answer": "partimos"}, {"type": "fill", "text": "Eles ___ o jogo（assistir）", "answer": "assistem"}, {"type": "choice", "text": "-er 與 -ir 動詞的現在式，哪個人稱不一樣？", "answer": "nós", "options": ["nós", "eu", "eles"]}]},
  {"id": "pt.word.morar", "type": "word", "text": "morar", "ipa": "moˈɾaɾ", "pos": "v.", "meaning": "住、居住", "note": "-ar 規則動詞：moro、mora、moramos、moram。", "examples": [{"text": "Eu moro em Taipei", "meaning": "我住在台北"}]},
  {"id": "pt.word.trabalhar", "type": "word", "text": "trabalhar", "ipa": "tɾabaˈʎaɾ", "pos": "v.", "meaning": "工作", "note": "-ar 規則動詞。", "examples": [{"text": "Ela trabalha no hospital", "meaning": "她在醫院工作"}]},
  {"id": "pt.word.estudar", "type": "word", "text": "estudar", "ipa": "istuˈdaɾ", "pos": "v.", "meaning": "讀書、學習（用功）", "note": "-ar 規則動詞。", "examples": [{"text": "Nós estudamos português juntos", "meaning": "我們一起讀葡萄牙語"}]},
  {"id": "pt.word.gostar", "type": "word", "text": "gostar", "ipa": "ɡosˈtaɾ", "pos": "v.", "meaning": "喜歡", "note": "後面一定接 de。", "examples": [{"text": "Eu gosto de música brasileira", "meaning": "我喜歡巴西音樂"}]},
  {"id": "pt.word.comer", "type": "word", "text": "comer", "ipa": "koˈmeɾ", "pos": "v.", "meaning": "吃", "note": "-er 規則動詞：como、come、comemos、comem。", "examples": [{"text": "Eu como arroz todo dia", "meaning": "我每天吃飯"}]},
  {"id": "pt.word.beber", "type": "word", "text": "beber", "ipa": "beˈbeɾ", "pos": "v.", "meaning": "喝", "note": "-er 規則動詞。口語也常用 tomar。", "examples": [{"text": "Você bebe café de manhã?", "meaning": "你早上喝咖啡嗎？"}]},
  {"id": "pt.word.aprender", "type": "word", "text": "aprender", "ipa": "apɾẽˈdeɾ", "pos": "v.", "meaning": "學會、學習（新事物）", "note": "-er 規則動詞。", "examples": [{"text": "Eu quero aprender a tocar berimbau", "meaning": "我想學彈弓琴"}]},
  {"id": "pt.word.abrir", "type": "word", "text": "abrir", "ipa": "aˈbɾiɾ", "pos": "v.", "meaning": "打開", "note": "-ir 規則動詞：abro、abre、abrimos、abrem。", "examples": [{"text": "O mestre vai abrir a roda", "meaning": "師父要開圈了"}]}
]
