[
  {
    "id": "ko.grammar.sov", "type": "grammar", "title": "基本語序：主語＋受詞＋動詞",
    "pattern": "主語 ＋ 受詞 ＋ 動詞",
    "explanation": "韓語的動詞（或形容詞）永遠放在句子最後，受詞在動詞前面，和中文的「主語＋動詞＋受詞」相反。名詞後面會接助詞標示它在句中的角色，所以主語和受詞的順序可以調換，但動詞一定在句尾。",
    "examples": [
      { "text": "저는 밥을 먹어요.", "meaning": "我吃飯。" },
      { "text": "친구가 책을 읽어요.", "meaning": "朋友讀書。" },
      { "text": "저는 물을 마셔요.", "meaning": "我喝水。" }
    ],
    "pitfalls": ["照中文語序把動詞放在受詞前面，例如「저는 먹어요 밥을」"],
    "drills": [
      { "type": "reorder", "text": "我吃飯。", "answer": "저는 밥을 먹어요" },
      { "type": "reorder", "text": "朋友讀書。", "answer": "친구가 책을 읽어요" },
      { "type": "fill", "text": "저는 물을 ___. （我喝水。）", "answer": "마셔요" },
      { "type": "choice", "text": "저는 ___ 먹어요. （我吃飯。）", "answer": "밥을", "options": ["밥을", "먹어요", "저는"] }
    ]
  },
  {
    "id": "ko.grammar.ieyo", "type": "grammar", "title": "是～：이에요／예요",
    "pattern": "名詞 ＋ 이에요／예요",
    "explanation": "接在名詞後面表示「是～」，屬於口語敬語。名詞最後一個字有終聲（收尾子音）時接 이에요，沒有終聲時接 예요。例如 학생（有終聲 ㅇ）→ 학생이에요；사과（無終聲）→ 사과예요。",
    "examples": [
      { "text": "저는 학생이에요.", "meaning": "我是學生。" },
      { "text": "이것은 사과예요.", "meaning": "這是蘋果。" },
      { "text": "제 이름은 민수예요.", "meaning": "我的名字是民秀。" }
    ],
    "pitfalls": ["不看終聲一律用 이에요", "把 예요 寫成 에요"],
    "drills": [
      { "type": "fill", "text": "저는 학생___. （我是學生。）", "answer": "이에요" },
      { "type": "fill", "text": "이것은 사과___. （這是蘋果。）", "answer": "예요" },
      { "type": "choice", "text": "친구___. （是朋友。）", "answer": "예요", "options": ["이에요", "예요"] },
      { "type": "choice", "text": "선생님___. （是老師。）", "answer": "이에요", "options": ["이에요", "예요"] },
      { "type": "reorder", "text": "我的名字是民秀。", "answer": "제 이름은 민수예요" }
    ]
  },
  {
    "id": "ko.grammar.anieyo", "type": "grammar", "title": "不是～：이／가 아니에요",
    "pattern": "名詞 ＋ 이／가 아니에요",
    "explanation": "「是～」的否定。名詞後先接助詞 이（有終聲）或 가（無終聲），再接 아니에요。例如 학생 → 학생이 아니에요；사과 → 사과가 아니에요。",
    "examples": [
