[
  {"id": "ko.grammar.neg-an", "type": "grammar", "title": "短否定 안", "pattern": "안 ＋ 動詞／形容詞", "explanation": "把 안 放在動詞或形容詞前面表示「不～」。名詞＋하다 的動詞要把 안 放在 하다 前面：공부 안 해요。但 좋아하다、싫어하다 等不可拆開：안 좋아해요。", "examples": [{"text": "오늘은 안 가요.", "meaning": "今天不去。"}, {"text": "고기를 안 먹어요.", "meaning": "不吃肉。"}, {"text": "공부 안 해요.", "meaning": "不讀書。"}], "pitfalls": ["안 공부해요 是錯的，要說 공부 안 해요"], "drills": [{"type": "reorder", "text": "我不吃肉。", "answer": "저는 고기를 안 먹어요"}, {"type": "choice", "text": "「不讀書」正確的是？", "answer": "공부 안 해요", "options": ["공부 안 해요", "안 공부해요"]}, {"type": "fill", "text": "오늘은 ___ 가요. （今天不去。）", "answer": "안"}, {"type": "reorder", "text": "今天不忙。", "answer": "오늘은 안 바빠요"}]},
  {"id": "ko.grammar.neg-ji-anayo", "type": "grammar", "title": "長否定 -지 않아요", "pattern": "語幹 ＋ 지 않아요", "explanation": "語幹直接加 지 않아요，不分終聲、不用變形，意思和 안 相同但較正式、書面。長的動詞或形容詞用這個比較自然。", "examples": [{"text": "학교에 가지 않아요.", "meaning": "不去學校。"}, {"text": "고기를 먹지 않아요.", "meaning": "不吃肉。"}, {"text": "오늘은 바쁘지 않아요.", "meaning": "今天不忙。"}], "pitfalls": ["語幹先變成 아/어 形再接：먹어지 않아요 是錯的"], "drills": [{"type": "fill", "text": "가다 → 가___ 않아요 （不去）", "answer": "지"}, {"type": "choice", "text": "먹다 的長否定是？", "answer": "먹지 않아요", "options": ["먹지 않아요", "먹어지 않아요", "안 먹지요"]}, {"type": "reorder", "text": "我不喝咖啡。", "answer": "저는 커피를 마시지 않아요"}, {"type": "fill", "text": "춥다 → ___ 않아요 （不冷）", "answer": "춥지"}]},
  {"id": "ko.grammar.neg-mot", "type": "grammar", "title": "不能 못", "pattern": "못 ＋ 動詞", "explanation": "못 表示「能力不足或情況不允許而做不到」，안 則是「不想做或單純沒做」。位置規則和 안 相同：수영 못 해요。못 只接動詞，不接形容詞。", "examples": [{"text": "오늘은 못 가요.", "meaning": "今天去不了。"}, {"text": "술을 못 마셔요.", "meaning": "不能喝酒。"}, {"text": "수영 못 해요.", "meaning": "不會游泳。"}], "pitfalls": ["안 和 못 混用：안 가요（不去）≠ 못 가요（去不了）"], "drills": [{"type": "choice", "text": "「（想去但）去不了」是？", "answer": "못 가요", "options": ["못 가요", "안 가요"]}, {"type": "choice", "text": "「（不想吃所以）不吃」是？", "answer": "안 먹어요", "options": ["안 먹어요", "못 먹어요"]}, {"type": "reorder", "text": "我不能喝酒。", "answer": "저는 술을 못 마셔요"}, {"type": "fill", "text": "매운 음식을 ___ 먹어요. （不能吃辣的食物。）", "answer": "못"}]}
]
