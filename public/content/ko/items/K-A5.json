  {"id": "ko.word.jip", "type": "word", "text": "집", "roman": "jip", "pos": "名", "meaning": "家", "note": "終聲 ㅂ 讀 p。\n終聲只有七個代表音：ㄱ ㄴ ㄷ ㄹ ㅁ ㅂ ㅇ。", "examples": [{"text": "집에 가요", "meaning": "回家"}]}
