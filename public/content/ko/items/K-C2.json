[
  {"id": "ko.grammar.topic-eun-neun", "type": "grammar", "title": "主題助詞 은／는", "pattern": "名詞 ＋ 은／는", "explanation": "標示句子的話題「至於～」，也用於對比。名詞有終聲接 은，沒有終聲接 는。自我介紹、陳述一般事實時最常用。", "examples": [{"text": "저는 학생이에요.", "meaning": "我是學生。"}, {"text": "오늘은 월요일이에요.", "meaning": "今天是星期一。"}, {"text": "이것은 책이에요.", "meaning": "這是書。"}], "pitfalls": ["不看終聲亂接", "第一次提到的新資訊卻用 은/는（應用 이/가）"], "drills": [{"type": "fill", "text": "저___ 대만 사람이에요. （我是台灣人。）", "answer": "는"}, {"type": "fill", "text": "선생님___ 한국 사람이에요. （老師是韓國人。）", "answer": "은"}, {"type": "choice", "text": "오늘___ 토요일이에요. （今天是星期六。）", "answer": "은", "options": ["은", "는"]}, {"type": "reorder", "text": "我是台灣人。", "answer": "저는 대만 사람이에요"}]},
  {"id": "ko.grammar.subject-i-ga", "type": "grammar", "title": "主格助詞 이／가", "pattern": "名詞 ＋ 이／가", "explanation": "標示動作或狀態的主語，常用於新資訊、回答「誰／什麼」，以及 있어요／없어요、形容詞句。有終聲接 이，沒有終聲接 가。", "examples": [{"text": "친구가 와요.", "meaning": "朋友來。"}, {"text": "비가 와요.", "meaning": "下雨。"}, {"text": "시간이 없어요.", "meaning": "沒有時間。"}], "pitfalls": ["「我」加 가 時要變形：저＋가 → 제가（不是 저가）"], "drills": [{"type": "fill", "text": "친구___ 와요. （朋友來。）", "answer": "가"}, {"type": "fill", "text": "시간___ 없어요. （沒有時間。）", "answer": "이"}, {"type": "choice", "text": "돈___ 있어요. （有錢。）", "answer": "이", "options": ["이", "가"]}, {"type": "reorder", "text": "朋友讀書。", "answer": "친구가 책을 읽어요"}]},
  {"id": "ko.grammar.object-eul-reul", "type": "grammar", "title": "受格助詞 을／를", "pattern": "名詞 ＋ 을／를", "explanation": "標示動作的對象（受詞）。有終聲接 을，沒有終聲接 를。口語中常省略，但初學階段請完整說出。", "examples": [{"text": "밥을 먹어요.", "meaning": "吃飯。"}, {"text": "커피를 마셔요.", "meaning": "喝咖啡。"}, {"text": "책을 읽어요.", "meaning": "讀書。"}], "pitfalls": ["좋아하다（喜歡）的對象用 을/를，但 좋다（好）的對象用 이/가"], "drills": [{"type": "fill", "text": "커피___ 마셔요. （喝咖啡。）", "answer": "를"}, {"type": "fill", "text": "책___ 읽어요. （讀書。）", "answer": "을"}, {"type": "choice", "text": "영화___ 봐요. （看電影。）", "answer": "를", "options": ["을", "를"]}, {"type": "reorder", "text": "我喝咖啡。", "answer": "저는 커피를 마셔요"}]},
  {"id": "ko.grammar.particle-e", "type": "grammar", "title": "時間與目的地 에", "pattern": "時間／地點 ＋ 에", "explanation": "에 有三個常見用法：① 移動的目的地（가다、오다）；② 存在的位置（있다、없다）；③ 時間點。不分有無終聲。오늘、내일、어제、지금 後面不加 에。", "examples": [{"text": "학교에 가요.", "meaning": "去學校。"}, {"text": "아침에 일어나요.", "meaning": "早上起床。"}, {"text": "집에 있어요.", "meaning": "在家。"}], "pitfalls": ["오늘에、내일에 是錯的，這些詞不加 에"], "drills": [{"type": "fill", "text": "학교___ 가요. （去學校。）", "answer": "에"}, {"type": "choice", "text": "저는 집___ 있어요. （我在家。）", "answer": "에", "options": ["에", "을", "는"]}, {"type": "choice", "text": "아침___ 운동해요. （早上運動。）", "answer": "에", "options": ["에", "를", "가"]}, {"type": "reorder", "text": "我星期一去公司。", "answer": "저는 월요일에 회사에 가요"}]},
  {"id": "ko.grammar.particle-eseo", "type": "grammar", "title": "動作地點 에서", "pattern": "地點 ＋ 에서", "explanation": "標示動作發生的場所「在～（做某事）」，也表示出發點「從～」。和 에 的差別：에 只是「在」或「去」，에서 後面一定有動作。", "examples": [{"text": "회사에서 일해요.", "meaning": "在公司工作。"}, {"text": "식당에서 밥을 먹어요.", "meaning": "在餐廳吃飯。"}, {"text": "대만에서 왔어요.", "meaning": "我來自台灣。"}], "pitfalls": ["存在句用 에（집에 있어요），動作句用 에서（집에서 쉬어요）"], "drills": [{"type": "choice", "text": "도서관___ 공부해요. （在圖書館讀書。）", "answer": "에서", "options": ["에", "에서"]}, {"type": "choice", "text": "학교___ 가요. （去學校。）", "answer": "에", "options": ["에", "에서"]}, {"type": "fill", "text": "식당___ 밥을 먹어요. （在餐廳吃飯。）", "answer": "에서"}, {"type": "reorder", "text": "我在公司工作。", "answer": "저는 회사에서 일해요"}]},
  {"id": "ko.grammar.particle-do", "type": "grammar", "title": "也 도", "pattern": "名詞 ＋ 도", "explanation": "表示「也」。直接取代 은/는、이/가、을/를（不能並用）；但可以接在 에、에서 後面（집에도、학교에서도）。", "examples": [{"text": "저도 학생이에요.", "meaning": "我也是學生。"}, {"text": "커피도 좋아해요.", "meaning": "也喜歡咖啡。"}, {"text": "친구도 와요.", "meaning": "朋友也來。"}], "pitfalls": ["저는도、커피를도 是錯的，도 要取代原本的助詞"], "drills": [{"type": "fill", "text": "저___ 대만 사람이에요. （我也是台灣人。）", "answer": "도"}, {"type": "choice", "text": "「我也喝水」：저는 물___ 마셔요.", "answer": "도", "options": ["도", "을도", "는"]}, {"type": "choice", "text": "「我也是學生」是？", "answer": "저도 학생이에요", "options": ["저도 학생이에요", "저는도 학생이에요", "저가도 학생이에요"]}, {"type": "reorder", "text": "朋友也喜歡咖啡。", "answer": "친구도 커피를 좋아해요"}]}
]
