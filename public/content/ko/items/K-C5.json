[
  {"id": "ko.grammar.past-asseoyo", "type": "grammar", "title": "過去式一：-았어요", "pattern": "語幹末母音 ㅏ／ㅗ ＋ 았어요", "explanation": "規則和現在式相同，把 아요 換成 았어요。縮約也相同：가다 → 갔어요，오다 → 왔어요，보다 → 봤어요。", "examples": [{"text": "어제 학교에 갔어요.", "meaning": "昨天去了學校。"}, {"text": "친구가 왔어요.", "meaning": "朋友來了。"}, {"text": "영화를 봤어요.", "meaning": "看了電影。"}], "pitfalls": ["가았어요 沒有縮約"], "drills": [{"type": "fill", "text": "가다 → ___ （過去式）", "answer": "갔어요"}, {"type": "fill", "text": "보다 → ___ （過去式）", "answer": "봤어요"}, {"type": "choice", "text": "살다 → ?", "answer": "살았어요", "options": ["살았어요", "살었어요", "살했어요"]}, {"type": "reorder", "text": "昨天看了電影。", "answer": "어제 영화를 봤어요"}]},
  {"id": "ko.grammar.past-eosseoyo", "type": "grammar", "title": "過去式二：-었어요", "pattern": "語幹末母音非 ㅏ／ㅗ ＋ 었어요", "explanation": "把現在式的 어요 換成 었어요：먹다 → 먹었어요，마시다 → 마셨어요，배우다 → 배웠어요。", "examples": [{"text": "밥을 먹었어요.", "meaning": "吃了飯。"}, {"text": "커피를 마셨어요.", "meaning": "喝了咖啡。"}, {"text": "한국어를 배웠어요.", "meaning": "學了韓語。"}], "pitfalls": ["마시었어요 沒有縮約"], "drills": [{"type": "fill", "text": "먹다 → ___ （過去式）", "answer": "먹었어요"}, {"type": "fill", "text": "마시다 → ___ （過去式）", "answer": "마셨어요"}, {"type": "choice", "text": "배우다 → ?", "answer": "배웠어요", "options": ["배웠어요", "배왔어요", "배우었요"]}, {"type": "reorder", "text": "早上喝了咖啡。", "answer": "아침에 커피를 마셨어요"}]},
  {"id": "ko.grammar.past-haesseoyo", "type": "grammar", "title": "過去式三：했어요", "pattern": "하다 → 했어요", "explanation": "하다 類一律變成 했어요：공부하다 → 공부했어요，운동하다 → 운동했어요。", "examples": [{"text": "어제 공부했어요.", "meaning": "昨天讀了書。"}, {"text": "주말에 운동했어요.", "meaning": "週末運動了。"}, {"text": "친구에게 전화했어요.", "meaning": "打了電話給朋友。"}], "pitfalls": ["寫成 하았어요 或 핬어요"], "drills": [{"type": "fill", "text": "일하다 → ___ （過去式）", "answer": "일했어요"}, {"type": "choice", "text": "좋아하다 → ?", "answer": "좋아했어요", "options": ["좋아했어요", "좋아핬어요", "좋아하았어요"]}, {"type": "reorder", "text": "我週末運動了。", "answer": "저는 주말에 운동했어요"}, {"type": "fill", "text": "공부하다 → ___ （過去式）", "answer": "공부했어요"}]},
  {"id": "ko.grammar.past-noun", "type": "grammar", "title": "名詞的過去式：이었어요／였어요", "pattern": "名詞 ＋ 이었어요／였어요", "explanation": "이에요/예요 的過去式「以前是～」。有終聲接 이었어요，沒有終聲接 였어요。", "examples": [{"text": "저는 학생이었어요.", "meaning": "我以前是學生。"}, {"text": "그 사람은 의사였어요.", "meaning": "那個人以前是醫生。"}, {"text": "어제는 일요일이었어요.", "meaning": "昨天是星期日。"}], "pitfalls": ["無終聲的名詞寫成 이였어요"], "drills": [{"type": "fill", "text": "학생___. （以前是學生。）", "answer": "이었어요"}, {"type": "fill", "text": "의사___. （以前是醫生。）", "answer": "였어요"}, {"type": "choice", "text": "친구___. （以前是朋友。）", "answer": "였어요", "options": ["였어요", "이었어요"]}, {"type": "reorder", "text": "昨天是我的生日。", "answer": "어제는 제 생일이었어요"}]}
