[
  {"id": "ko.grammar.linking", "type": "grammar", "title": "連音（연음）", "pattern": "終聲 ＋ ㅇ開頭的音節 → 終聲移到後面當初聲", "explanation": "前一個音節有終聲，而後一個音節以不發音的 ㅇ 開頭時，終聲會移過去填補 ㅇ 的位置。拼字不變，只有發音改變。例如 음악 寫作 음＋악，讀作 [으막]。", "examples": [{"text": "음악", "meaning": "音樂（讀作 [으막]）"}, {"text": "한국어", "meaning": "韓語（讀作 [한구거]）"}, {"text": "있어요", "meaning": "有（讀作 [이써요]）"}], "pitfalls": ["照字面一個音節一個音節分開唸", "終聲是 ㅇ 時不連音（강아지 仍讀 [강아지]）"], "drills": [{"type": "choice", "text": "음악 的實際發音是？", "answer": "[으막]", "options": ["[으막]", "[음악]", "[음막]"]}, {"type": "choice", "text": "한국어 的實際發音是？", "answer": "[한구거]", "options": ["[한구거]", "[한국어]", "[한궁어]"]}, {"type": "choice", "text": "읽어요 的實際發音是？", "answer": "[일거요]", "options": ["[일거요]", "[익어요]", "[이러요]"]}]},
  {"id": "ko.word.eumak", "type": "word", "text": "음악", "roman": "eumak", "pos": "名", "meaning": "音樂", "note": "連音：讀作 [으막]。", "examples": [{"text": "음악을 들어요", "meaning": "聽音樂"}]},
  {"id": "ko.word.hangugeo", "type": "word", "text": "한국어", "roman": "hangugeo", "pos": "名", "meaning": "韓語", "note": "連音：讀作 [한구거]。", "examples": [{"text": "한국어를 배워요", "meaning": "學韓語"}]},
  {"id": "ko.word.isseoyo", "type": "word", "text": "있어요", "roman": "isseoyo", "pos": "動", "meaning": "有／在（口語敬體）", "note": "連音：讀作 [이써요]。", "examples": [{"text": "시간이 있어요", "meaning": "有時間"}]},
  {"id": "ko.word.ilgeoyo", "type": "word", "text": "읽어요", "roman": "ilgeoyo", "pos": "動", "meaning": "讀（口語敬體）", "note": "雙終聲 ㄺ：ㄹ 留下，ㄱ 連到後面，讀作 [일거요]。", "examples": [{"text": "책을 읽어요", "meaning": "讀書"}]},
  {"id": "ko.grammar.nasalization", "type": "grammar", "title": "鼻音化（비음화）", "pattern": "ㄱ ㄷ ㅂ ＋ ㄴ ㅁ → ㅇ ㄴ ㅁ ＋ ㄴ ㅁ", "explanation": "終聲 ㄱ、ㄷ、ㅂ（含其代表音）後面接 ㄴ 或 ㅁ 時，會被同化成鼻音：ㄱ→ㅇ、ㄷ→ㄴ、ㅂ→ㅁ。例如 입니다 讀作 [임니다]。", "examples": [{"text": "입니다", "meaning": "是（讀作 [임니다]）"}, {"text": "한국말", "meaning": "韓國話（讀作 [한궁말]）"}, {"text": "국물", "meaning": "湯（讀作 [궁물]）"}], "pitfalls": ["把 입니다 唸成 [입니다]，p 音太清楚"], "drills": [{"type": "choice", "text": "입니다 的實際發音是？", "answer": "[임니다]", "options": ["[임니다]", "[입니다]", "[인니다]"]}, {"type": "choice", "text": "한국말 的實際發音是？", "answer": "[한궁말]", "options": ["[한궁말]", "[한국말]", "[한굼말]"]}, {"type": "choice", "text": "終聲 ㅂ 後面接 ㄴ 時，ㅂ 會變成？", "answer": "ㅁ", "options": ["ㅁ", "ㅇ", "ㄴ"]}]},
  {"id": "ko.word.imnida", "type": "word", "text": "입니다", "roman": "imnida", "pos": "語尾", "meaning": "是（格式體）", "note": "鼻音化：ㅂ＋ㄴ → ㅁ＋ㄴ，讀作 [임니다]。", "examples": [{"text": "학생입니다", "meaning": "是學生"}]},
  {"id": "ko.word.hamnida", "type": "word", "text": "합니다", "roman": "hamnida", "pos": "動", "meaning": "做（格式體）", "note": "鼻音化：讀作 [함니다]。", "examples": [{"text": "일을 합니다", "meaning": "做工作"}]},
  {"id": "ko.word.hangungmal", "type": "word", "text": "한국말", "roman": "hangungmal", "pos": "名", "meaning": "韓國話", "note": "鼻音化：ㄱ＋ㅁ → ㅇ＋ㅁ，讀作 [한궁말]。", "examples": [{"text": "한국말을 잘해요", "meaning": "韓國話說得好"}]},
  {"id": "ko.word.gungmul", "type": "word", "text": "국물", "roman": "gungmul", "pos": "名", "meaning": "湯、湯汁", "note": "鼻音化：讀作 [궁물]。", "examples": [{"text": "국물이 맛있어요", "meaning": "湯很好喝"}]},
  {"id": "ko.grammar.aspiration", "type": "grammar", "title": "激音化（격음화）", "pattern": "ㄱ ㄷ ㅂ ㅈ ＋ ㅎ（或 ㅎ ＋ ㄱ ㄷ ㅂ ㅈ）→ ㅋ ㅌ ㅍ ㅊ", "explanation": "ㅎ 與 ㄱ、ㄷ、ㅂ、ㅈ 相遇時（不論前後順序），兩者合併成對應的送氣音 ㅋ、ㅌ、ㅍ、ㅊ。例如 축하 讀作 [추카]。", "examples": [{"text": "축하", "meaning": "祝賀（讀作 [추카]）"}, {"text": "백화점", "meaning": "百貨公司（讀作 [배콰점]）"}, {"text": "어떻게", "meaning": "怎麼（讀作 [어떠케]）"}], "pitfalls": ["把 ㅎ 單獨唸出來，例如 축하 唸成 [축하]"], "drills": [{"type": "choice", "text": "축하 的實際發音是？", "answer": "[추카]", "options": ["[추카]", "[축하]", "[추가]"]}, {"type": "choice", "text": "어떻게 的實際發音是？", "answer": "[어떠케]", "options": ["[어떠케]", "[어떧게]", "[어떠게]"]}, {"type": "choice", "text": "ㄱ 和 ㅎ 相遇會合併成？", "answer": "ㅋ", "options": ["ㅋ", "ㄲ", "ㅇ"]}]},
  {"id": "ko.grammar.tensing", "type": "grammar", "title": "硬化（경음화）", "pattern": "終聲 ㄱ ㄷ ㅂ ＋ ㄱ ㄷ ㅂ ㅅ ㅈ → 後者變 ㄲ ㄸ ㅃ ㅆ ㅉ", "explanation": "終聲 ㄱ、ㄷ、ㅂ 後面接 ㄱ、ㄷ、ㅂ、ㅅ、ㅈ 開頭的音節時，後面的子音會變成緊音。例如 학교 讀作 [학꾜]。", "examples": [{"text": "학교", "meaning": "學校（讀作 [학꾜]）"}, {"text": "숙제", "meaning": "作業（讀作 [숙쩨]）"}, {"text": "입구", "meaning": "入口（讀作 [입꾸]）"}], "pitfalls": ["後面的子音唸得太鬆，例如 학교 唸成 [학교]"], "drills": [{"type": "choice", "text": "학교 的實際發音是？", "answer": "[학꾜]", "options": ["[학꾜]", "[학교]", "[항교]"]}, {"type": "choice", "text": "숙제 的實際發音是？", "answer": "[숙쩨]", "options": ["[숙쩨]", "[숙제]", "[숭제]"]}, {"type": "choice", "text": "終聲 ㅂ 後面的 ㄱ 會變成？", "answer": "ㄲ", "options": ["ㄲ", "ㅋ", "ㅇ"]}]},
  {"id": "ko.word.chuka", "type": "word", "text": "축하", "roman": "chuka", "pos": "名", "meaning": "祝賀", "note": "激音化：ㄱ＋ㅎ → ㅋ，讀作 [추카]。", "examples": [{"text": "생일 축하해요", "meaning": "生日快樂"}]},
  {"id": "ko.word.baekwajeom", "type": "word", "text": "백화점", "roman": "baekwajeom", "pos": "名", "meaning": "百貨公司", "note": "激音化：讀作 [배콰점]。", "examples": [{"text": "백화점에 가요", "meaning": "去百貨公司"}]},
  {"id": "ko.word.eotteoke", "type": "word", "text": "어떻게", "roman": "eotteoke", "pos": "副", "meaning": "怎麼、如何", "note": "激音化：ㅎ＋ㄱ → ㅋ，讀作 [어떠케]。", "examples": [{"text": "어떻게 가요?", "meaning": "怎麼去？"}]},
  {"id": "ko.word.sukje", "type": "word", "text": "숙제", "roman": "sukje", "pos": "名", "meaning": "作業", "note": "硬化：讀作 [숙쩨]。", "examples": [{"text": "숙제를 해요", "meaning": "做作業"}]},
  {"id": "ko.word.ipgu", "type": "word", "text": "입구", "roman": "ipgu", "pos": "名", "meaning": "入口", "note": "硬化：讀作 [입꾸]。", "examples": [{"text": "입구가 어디예요?", "meaning": "入口在哪裡？"}]},
  {"id": "ko.word.gukbap", "type": "word", "text": "국밥", "roman": "gukbap", "pos": "名", "meaning": "湯飯", "note": "硬化：讀作 [국빱]。", "examples": [{"text": "국밥을 먹어요", "meaning": "吃湯飯"}]}
]
