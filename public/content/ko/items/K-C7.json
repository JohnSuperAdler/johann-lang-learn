[
  {"id": "ko.grammar.conn-go", "type": "grammar", "title": "並列與先後：-고", "pattern": "語幹 ＋ 고", "explanation": "連接兩個句子，表示「而且」（並列）或「然後」（先後）。語幹直接加 고，不分終聲。", "examples": [{"text": "밥을 먹고 커피를 마셔요.", "meaning": "吃飯然後喝咖啡。"}, {"text": "이 가방은 싸고 좋아요.", "meaning": "這個包包便宜又好。"}, {"text": "숙제를 하고 자요.", "meaning": "做完作業睡覺。"}], "pitfalls": ["前句加時態：먹었고 在先後順序句中不自然，時態放在句尾即可"], "drills": [{"type": "fill", "text": "먹다 → 밥을 ___ 커피를 마셔요. （吃飯然後喝咖啡）", "answer": "먹고"}, {"type": "choice", "text": "「便宜又好」是？", "answer": "싸고 좋아요", "options": ["싸고 좋아요", "싸지만 좋아요", "싸면 좋아요"]}, {"type": "reorder", "text": "吃飯然後喝咖啡。", "answer": "밥을 먹고 커피를 마셔요"}, {"type": "fill", "text": "하다 → 숙제를 ___ 자요. （做完作業睡覺）", "answer": "하고"}]},
  {"id": "ko.grammar.conn-jiman", "type": "grammar", "title": "轉折：-지만", "pattern": "語幹 ＋ 지만", "explanation": "表示「雖然～但是～」。語幹直接加 지만，不分終聲。過去的事可加過去式：갔지만。", "examples": [{"text": "한국어는 어렵지만 재미있어요.", "meaning": "韓語很難但是很有趣。"}, {"text": "비싸지만 맛있어요.", "meaning": "貴但是好吃。"}, {"text": "피곤하지만 운동해요.", "meaning": "雖然累還是運動。"}], "pitfalls": ["和 -고 混用"], "drills": [{"type": "fill", "text": "어렵다 → ___ 재미있어요. （難但有趣）", "answer": "어렵지만"}, {"type": "choice", "text": "「貴但是好吃」是？", "answer": "비싸지만 맛있어요", "options": ["비싸지만 맛있어요", "비싸고 맛있어요", "비싸서 맛있어요"]}, {"type": "reorder", "text": "韓語很難但是很有趣。", "answer": "한국어는 어렵지만 재미있어요"}, {"type": "fill", "text": "피곤하다 → ___ 운동해요. （雖然累還是運動）", "answer": "피곤하지만"}]},
  {"id": "ko.grammar.conn-aseo", "type": "grammar", "title": "原因與順序：-아서／어서", "pattern": "語幹 ＋ 아서／어서", "explanation": "表示原因「因為～所以～」，或緊接的動作順序。接法同 -아요/어요，把 요 換成 서：바쁘다 → 바빠서，먹다 → 먹어서，하다 → 해서。", "examples": [{"text": "바빠서 못 가요.", "meaning": "因為忙所以去不了。"}, {"text": "배가 고파서 밥을 먹어요.", "meaning": "因為肚子餓所以吃飯。"}, {"text": "만나서 반갑습니다.", "meaning": "很高興見到你。"}], "pitfalls": ["前句不能加過去式：갔어서 是錯的", "後句不能是命令或勸誘（那要用 -(으)니까）"], "drills": [{"type": "fill", "text": "바쁘다 → ___ 못 가요. （因為忙所以去不了）", "answer": "바빠서"}, {"type": "choice", "text": "「因為累所以休息」是？", "answer": "피곤해서 쉬어요", "options": ["피곤해서 쉬어요", "피곤하지만 쉬어요", "피곤하고 쉬어요"]}, {"type": "reorder", "text": "因為肚子餓所以吃飯。", "answer": "배가 고파서 밥을 먹어요"}, {"type": "choice", "text": "下列哪一個正確？", "answer": "늦어서 미안해요", "options": ["늦어서 미안해요", "늦었어서 미안해요"]}]},
  {"id": "ko.grammar.conn-nikka", "type": "grammar", "title": "理由（可接命令勸誘）：-(으)니까", "pattern": "語幹 ＋ (으)니까", "explanation": "同樣表示原因，但帶有說話者的判斷，而且後句可以是命令、勸誘、提議。無終聲加 니까（오다 → 오니까），有終聲加 으니까（없다 → 없으니까）。ㅂ 不規則：덥다 → 더우니까。", "examples": [{"text": "비가 오니까 택시를 타요.", "meaning": "因為下雨，搭計程車吧。"}, {"text": "시간이 없으니까 빨리 가요.", "meaning": "沒時間了，快走吧。"}, {"text": "더우니까 창문을 열어요.", "meaning": "很熱，開窗吧。"}], "pitfalls": ["道謝、道歉的理由不用 -(으)니까，要用 -아서/어서"], "drills": [{"type": "fill", "text": "오다 → 비가 ___ 택시를 타요.", "answer": "오니까"}, {"type": "fill", "text": "없다 → 시간이 ___ 빨리 가요.", "answer": "없으니까"}, {"type": "choice", "text": "後句是「請～／～吧」時，表示原因要用？", "answer": "-(으)니까", "options": ["-(으)니까", "-아서/어서"]}, {"type": "reorder", "text": "因為下雨，搭計程車吧。", "answer": "비가 오니까 택시를 타요"}]}
]
