[
  {"id": "ko.grammar.future-geoyeyo", "type": "grammar", "title": "未來與推測：-(으)ㄹ 거예요", "pattern": "語幹 ＋ (으)ㄹ 거예요", "explanation": "表示未來的計畫「要～、會～」或推測。語幹無終聲加 ㄹ 거예요（가다 → 갈 거예요），有終聲加 을 거예요（먹다 → 먹을 거예요），語幹以 ㄹ 結尾直接加 거예요（살다 → 살 거예요）。", "examples": [{"text": "내일 학교에 갈 거예요.", "meaning": "明天要去學校。"}, {"text": "저녁에 김밥을 먹을 거예요.", "meaning": "晚上要吃紫菜飯捲。"}, {"text": "주말에 뭐 할 거예요?", "meaning": "週末要做什麼？"}], "pitfalls": ["有終聲卻只加 ㄹ：먹ㄹ 거예요", "寫成 거에요（正確是 거예요）"], "drills": [{"type": "fill", "text": "가다 → ___ 거예요", "answer": "갈"}, {"type": "fill", "text": "먹다 → ___ 거예요", "answer": "먹을"}, {"type": "choice", "text": "하다 → ?", "answer": "할 거예요", "options": ["할 거예요", "하을 거예요", "핼 거예요"]}, {"type": "reorder", "text": "明天要見朋友。", "answer": "내일 친구를 만날 거예요"}]},
  {"id": "ko.grammar.future-kkayo", "type": "grammar", "title": "提議與詢問：-(으)ㄹ까요?", "pattern": "語幹 ＋ (으)ㄹ까요?", "explanation": "用於提議「要不要（一起）～？」或詢問對方意見「～好呢？」。接法同上：가다 → 갈까요?，먹다 → 먹을까요?。回答常用 네, 좋아요 或 -아요/어요 勸誘形。", "examples": [{"text": "같이 갈까요?", "meaning": "要不要一起去？"}, {"text": "뭐 먹을까요?", "meaning": "要吃什麼呢？"}, {"text": "커피 마실까요?", "meaning": "要不要喝咖啡？"}], "pitfalls": ["用來問對方自己的計畫（那要用 -(으)ㄹ 거예요?）"], "drills": [{"type": "fill", "text": "가다 → 같이 ___? （要不要一起去？）", "answer": "갈까요"}, {"type": "fill", "text": "먹다 → 뭐 ___? （要吃什麼呢？）", "answer": "먹을까요"}, {"type": "choice", "text": "「같이 볼까요?」的意思是？", "answer": "要不要一起看？", "options": ["要不要一起看？", "我一起看了。", "請你看。"]}, {"type": "reorder", "text": "要不要一起喝咖啡？", "answer": "같이 커피를 마실까요"}]},
  {"id": "ko.grammar.future-geyo", "type": "grammar", "title": "承諾與當場決定：-(으)ㄹ게요", "pattern": "語幹 ＋ (으)ㄹ게요", "explanation": "說話者對聽者表明「我來～、我會～」的意志或承諾。只能用於第一人稱，不能用於疑問句。讀作 [ㄹ께요]。", "examples": [{"text": "제가 할게요.", "meaning": "我來做。"}, {"text": "내일 전화할게요.", "meaning": "我明天打給你。"}, {"text": "먼저 갈게요.", "meaning": "我先走了。"}], "pitfalls": ["用在第二、三人稱或疑問句", "寫成 ㄹ께요"], "drills": [{"type": "fill", "text": "하다 → 제가 ___. （我來做。）", "answer": "할게요"}, {"type": "choice", "text": "「我先走了」是？", "answer": "먼저 갈게요", "options": ["먼저 갈게요", "먼저 갈까요", "먼저 갔어요"]}, {"type": "reorder", "text": "我明天打電話給你。", "answer": "내일 제가 전화할게요"}, {"type": "fill", "text": "먹다 → 잘 ___. （我開動了。）", "answer": "먹을게요"}]}
]
