[
  {"id": "ko.letter.g", "type": "letter", "text": "ㄱ", "roman": "g / k", "name": "기역（giyeok）", "tts": "가", "note": "形狀像一把槍（gun）的轉角。\n字首接近 k，夾在母音之間接近 g，不送氣。\n筆順：一筆，先橫後向下。", "examples": [{"text": "가구", "meaning": "家具"}, {"text": "고기", "meaning": "肉"}]},
  {"id": "ko.letter.n", "type": "letter", "text": "ㄴ", "roman": "n", "name": "니은（nieun）", "tts": "나", "note": "形狀像舌尖頂住上牙齦的側面。\n發音同中文「ㄋ」。\n筆順：一筆，先豎後向右。", "examples": [{"text": "나", "meaning": "我"}, {"text": "누나", "meaning": "姊姊（男生用）"}]},
  {"id": "ko.letter.d", "type": "letter", "text": "ㄷ", "roman": "d / t", "name": "디귿（digeut）", "tts": "다", "note": "ㄴ 上面加一橫。\n字首接近 t，母音之間接近 d，不送氣。\n筆順：先寫上橫，再寫 ㄴ。", "examples": [{"text": "다리", "meaning": "腿／橋"}, {"text": "구두", "meaning": "皮鞋"}]},
  {"id": "ko.letter.r", "type": "letter", "text": "ㄹ", "roman": "r / l", "name": "리을（rieul）", "tts": "라", "note": "像蛇一樣彎曲。\n在母音前是輕彈舌的 r，在終聲是 l。\n筆順：三筆，ㄱ、橫、ㄴ。", "examples": [{"text": "라디오", "meaning": "收音機"}, {"text": "우리", "meaning": "我們"}]},
  {"id": "ko.letter.m", "type": "letter", "text": "ㅁ", "roman": "m", "name": "미음（mieum）", "tts": "마", "note": "形狀像閉起來的嘴（口）。\n發音同中文「ㄇ」。\n筆順：左豎、ㄱ、底橫。", "examples": [{"text": "머리", "meaning": "頭"}, {"text": "어머니", "meaning": "媽媽"}]},
  {"id": "ko.letter.b", "type": "letter", "text": "ㅂ", "roman": "b / p", "name": "비읍（bieup）", "tts": "바", "note": "像一個水桶（bucket）。\n字首接近 p，母音之間接近 b，不送氣。\n筆順：左豎、右豎、中橫、底橫。", "examples": [{"text": "바다", "meaning": "海"}, {"text": "바나나", "meaning": "香蕉"}]},
  {"id": "ko.letter.s", "type": "letter", "text": "ㅅ", "roman": "s", "name": "시옷（siot）", "tts": "사", "note": "像「人」字。\n發音同 s；在 ㅣ 前面接近中文「ㄒ」。\n筆順：先左撇再右捺。", "examples": [{"text": "사", "meaning": "四"}, {"text": "소", "meaning": "牛"}]},
  {"id": "ko.letter.ng", "type": "letter", "text": "ㅇ", "roman": "無聲 / ng", "name": "이응（ieung）", "tts": "응", "note": "一個圓圈。\n在字首不發音，只是佔位（아 讀 a）；在終聲讀 ng。\n筆順：一筆逆時針畫圓。", "examples": [{"text": "아이", "meaning": "小孩"}, {"text": "응", "meaning": "嗯"}]},
  {"id": "ko.letter.j", "type": "letter", "text": "ㅈ", "roman": "j", "name": "지읒（jieut）", "tts": "자", "note": "ㅅ 上面加一橫。\n接近中文「ㄗ／ㄐ」，不送氣。\n筆順：先橫（帶撇），再右捺。", "examples": [{"text": "자다", "meaning": "睡覺"}, {"text": "주스", "meaning": "果汁"}]},
  {"id": "ko.letter.ch", "type": "letter", "text": "ㅊ", "roman": "ch", "name": "치읓（chieut）", "tts": "차", "note": "ㅈ 上面加一點＝加強吐氣。\n接近中文「ㄘ／ㄑ」，明顯送氣。\n筆順：先上面短橫，再寫 ㅈ。", "examples": [{"text": "차", "meaning": "車／茶"}, {"text": "치마", "meaning": "裙子"}]},
  {"id": "ko.letter.k", "type": "letter", "text": "ㅋ", "roman": "k（送氣）", "name": "키읔（kieuk）", "tts": "카", "note": "ㄱ 中間加一橫＝加強吐氣。\n接近中文「ㄎ」，明顯送氣。\n筆順：先寫 ㄱ，再加中橫。", "examples": [{"text": "코", "meaning": "鼻子"}, {"text": "커피", "meaning": "咖啡"}]},
  {"id": "ko.letter.t", "type": "letter", "text": "ㅌ", "roman": "t（送氣）", "name": "티읕（tieut）", "tts": "타", "note": "ㄷ 中間加一橫＝加強吐氣。\n接近中文「ㄊ」，明顯送氣。\n筆順：上橫、中橫、再寫 ㄴ。", "examples": [{"text": "타다", "meaning": "搭乘"}, {"text": "토마토", "meaning": "番茄"}]},
  {"id": "ko.letter.p", "type": "letter", "text": "ㅍ", "roman": "p（送氣）", "name": "피읖（pieup）", "tts": "파", "note": "像羅馬數字 Ⅱ 上下加橫。\n接近中文「ㄆ」，明顯送氣。\n筆順：上橫、兩豎、底橫。", "examples": [{"text": "파", "meaning": "蔥"}, {"text": "포도", "meaning": "葡萄"}]},
  {"id": "ko.letter.h", "type": "letter", "text": "ㅎ", "roman": "h", "name": "히읗（hieut）", "tts": "하", "note": "ㅇ 上面戴一頂帽子。\n發音同中文「ㄏ」。\n筆順：短橫、長橫、圓圈。", "examples": [{"text": "하나", "meaning": "一"}, {"text": "허리", "meaning": "腰"}]}
]
