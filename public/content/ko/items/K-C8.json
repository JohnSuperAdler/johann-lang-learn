[
  {"id": "ko.grammar.can", "type": "grammar", "title": "能、會：-(으)ㄹ 수 있어요", "pattern": "語幹 ＋ (으)ㄹ 수 있어요", "explanation": "表示有能力或情況允許「能～、會～、可以～」。無終聲加 ㄹ 수 있어요（하다 → 할 수 있어요），有終聲加 을 수 있어요（먹다 → 먹을 수 있어요）。", "examples": [{"text": "한국어를 할 수 있어요.", "meaning": "會說韓語。"}, {"text": "김치를 먹을 수 있어요.", "meaning": "能吃泡菜。"}, {"text": "내일 갈 수 있어요.", "meaning": "明天可以去。"}], "pitfalls": ["수 前後要空格：할 수 있어요"], "drills": [{"type": "fill", "text": "하다 → ___ 수 있어요", "answer": "할"}, {"type": "fill", "text": "먹다 → ___ 수 있어요", "answer": "먹을"}, {"type": "reorder", "text": "我會說韓語。", "answer": "저는 한국어를 할 수 있어요"}, {"type": "choice", "text": "「明天可以去」是？", "answer": "내일 갈 수 있어요", "options": ["내일 갈 수 있어요", "내일 가 수 있어요", "내일 갈 수 이에요"]}]},
  {"id": "ko.grammar.cannot", "type": "grammar", "title": "不能、不會：-(으)ㄹ 수 없어요", "pattern": "語幹 ＋ (으)ㄹ 수 없어요", "explanation": "把 있어요 換成 없어요 就是「不能～、不會～」，意思接近 못，但較正式。", "examples": [{"text": "지금 갈 수 없어요.", "meaning": "現在不能去。"}, {"text": "매운 음식을 먹을 수 없어요.", "meaning": "不能吃辣的食物。"}, {"text": "한자를 읽을 수 없어요.", "meaning": "不會讀漢字。"}], "pitfalls": ["和 안（不想做）混淆"], "drills": [{"type": "fill", "text": "읽다 → ___ 수 없어요", "answer": "읽을"}, {"type": "choice", "text": "「갈 수 없어요」意思最接近？", "answer": "못 가요", "options": ["못 가요", "안 가요", "갈 거예요"]}, {"type": "reorder", "text": "我現在不能去。", "answer": "저는 지금 갈 수 없어요"}, {"type": "fill", "text": "가다 → 갈 수 ___. （不能去）", "answer": "없어요"}]},
  {"id": "ko.grammar.want", "type": "grammar", "title": "想要：-고 싶어요", "pattern": "語幹 ＋ 고 싶어요", "explanation": "表示說話者「想～」的願望。語幹直接加 고 싶어요，不分終聲。只用於第一人稱陳述和第二人稱疑問；第三人稱要用 -고 싶어해요。", "examples": [{"text": "한국에 가고 싶어요.", "meaning": "想去韓國。"}, {"text": "물을 마시고 싶어요.", "meaning": "想喝水。"}, {"text": "오늘은 쉬고 싶어요.", "meaning": "今天想休息。"}], "pitfalls": ["描述別人想做什麼時仍用 -고 싶어요"], "drills": [{"type": "fill", "text": "가다 → 한국에 ___ 싶어요.", "answer": "가고"}, {"type": "fill", "text": "먹다 → 불고기를 ___ 싶어요.", "answer": "먹고"}, {"type": "reorder", "text": "我想去韓國。", "answer": "저는 한국에 가고 싶어요"}, {"type": "choice", "text": "「想休息」是？", "answer": "쉬고 싶어요", "options": ["쉬고 싶어요", "쉬 싶어요", "쉬고 있어요"]}]}
]
