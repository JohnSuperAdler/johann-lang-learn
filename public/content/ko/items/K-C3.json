[
  {"id": "ko.grammar.present-ayo", "type": "grammar", "title": "現在式一：-아요", "pattern": "語幹末母音 ㅏ／ㅗ ＋ 아요", "explanation": "去掉原形的 다 得到語幹。語幹最後一個母音是 ㅏ 或 ㅗ 時接 아요。沒有終聲時會縮約：가＋아요 → 가요，오＋아요 → 와요，보＋아요 → 봐요。", "examples": [{"text": "학교에 가요.", "meaning": "去學校。"}, {"text": "대만에 살아요.", "meaning": "住在台灣。"}, {"text": "영화를 봐요.", "meaning": "看電影。"}], "pitfalls": ["가아요、오아요 沒有縮約"], "drills": [{"type": "fill", "text": "살다 → ___", "answer": "살아요"}, {"type": "fill", "text": "오다 → ___", "answer": "와요"}, {"type": "choice", "text": "받다 → ?", "answer": "받아요", "options": ["받아요", "받어요", "받해요"]}, {"type": "fill", "text": "가다 → ___", "answer": "가요"}]},
  {"id": "ko.grammar.present-eoyo", "type": "grammar", "title": "現在式二：-어요", "pattern": "語幹末母音非 ㅏ／ㅗ ＋ 어요", "explanation": "語幹最後一個母音不是 ㅏ、ㅗ 時接 어요。沒有終聲時縮約：마시＋어요 → 마셔요（ㅣ＋ㅓ → ㅕ），배우＋어요 → 배워요（ㅜ＋ㅓ → ㅝ）。", "examples": [{"text": "밥을 먹어요.", "meaning": "吃飯。"}, {"text": "물을 마셔요.", "meaning": "喝水。"}, {"text": "한국어를 배워요.", "meaning": "學韓語。"}], "pitfalls": ["마시어요、배우어요 沒有縮約"], "drills": [{"type": "fill", "text": "먹다 → ___", "answer": "먹어요"}, {"type": "fill", "text": "마시다 → ___", "answer": "마셔요"}, {"type": "choice", "text": "배우다 → ?", "answer": "배워요", "options": ["배워요", "배와요", "배우해요"]}, {"type": "fill", "text": "읽다 → ___", "answer": "읽어요"}]},
  {"id": "ko.grammar.present-haeyo", "type": "grammar", "title": "現在式三：해요", "pattern": "하다 → 해요", "explanation": "所有以 하다 結尾的動詞和形容詞，一律把 하다 換成 해요。名詞＋하다 構成的動詞非常多：공부하다、운동하다、일하다、전화하다。", "examples": [{"text": "매일 공부해요.", "meaning": "每天讀書。"}, {"text": "회사에서 일해요.", "meaning": "在公司工作。"}, {"text": "커피를 좋아해요.", "meaning": "喜歡咖啡。"}], "pitfalls": ["寫成 하요 或 하아요"], "drills": [{"type": "fill", "text": "공부하다 → ___", "answer": "공부해요"}, {"type": "fill", "text": "운동하다 → ___", "answer": "운동해요"}, {"type": "choice", "text": "좋아하다 → ?", "answer": "좋아해요", "options": ["좋아해요", "좋아하요", "좋아하어요"]}, {"type": "reorder", "text": "我每天讀書。", "answer": "저는 매일 공부해요"}]},
  {"id": "ko.grammar.present-usage", "type": "grammar", "title": "-아요／어요 的四種用法", "pattern": "同一形式 ＋ 不同語調", "explanation": "口語敬體 -아요/어요 同時是陳述、疑問、勸誘、命令四種句型，靠語調和情境區分。句尾上揚是疑問；加上 같이（一起）通常是勸誘。也可表示「正在做」。", "examples": [{"text": "뭐 해요?", "meaning": "你在做什麼？"}, {"text": "같이 가요.", "meaning": "一起去吧。"}, {"text": "지금 밥을 먹어요.", "meaning": "現在在吃飯。"}], "pitfalls": ["以為疑問句要另外加語尾；其實只要語調上揚"], "drills": [{"type": "choice", "text": "「뭐 해요?」的意思是？", "answer": "你在做什麼？", "options": ["你在做什麼？", "我在做什麼。", "請你做。"]}, {"type": "choice", "text": "把「가요.」變成疑問句的方法是？", "answer": "句尾語調上揚", "options": ["句尾語調上揚", "在句尾加 까", "把動詞移到句首"]}, {"type": "reorder", "text": "現在在吃飯。", "answer": "지금 밥을 먹어요"}, {"type": "choice", "text": "「같이 가요.」最自然的意思是？", "answer": "一起去吧。", "options": ["一起去吧。", "一起去了。", "不一起去。"]}]},
  {"id": "ko.grammar.present-irregular", "type": "grammar", "title": "ㅂ 不規則與 으 脫落", "pattern": "ㅂ → 우 ＋ 어요／ㅡ 脫落", "explanation": "① 語幹以 ㅂ 結尾的多數形容詞：ㅂ 變成 우 再接 어요 → 워요（덥다 → 더워요）。② 語幹以 ㅡ 結尾：ㅡ 脫落，依前一個母音接 아요/어요（바쁘다 → 바빠요，쓰다 → 써요）。", "examples": [{"text": "오늘은 더워요.", "meaning": "今天很熱。"}, {"text": "요즘 바빠요.", "meaning": "最近很忙。"}, {"text": "이름을 써요.", "meaning": "寫名字。"}], "pitfalls": ["덥어요、바쁘어요 是錯的", "입다（穿）是規則變化：입어요"], "drills": [{"type": "fill", "text": "덥다 → ___", "answer": "더워요"}, {"type": "fill", "text": "쓰다 → ___", "answer": "써요"}, {"type": "choice", "text": "바쁘다 → ?", "answer": "바빠요", "options": ["바빠요", "바쁘어요", "바뻐요"]}, {"type": "fill", "text": "춥다 → ___", "answer": "추워요"}]}
]
